<?xml version="1.0" encoding="utf-8"?>
<!-- Handgeschriebene Nachbildung eines Kalkulationsprogramm-Exports (Issue #41):
     jede Zeile eines Satzes steht in einem eigenen <p>, leere <p/> als
     Absatzabstand, Textergänzungen (<TextComplement>) mitten im Satz, <br>
     als bewusster Umbruch, Listen. Alle Texte sind erfunden. -->
<GAEB xmlns="http://www.gaeb.de/GAEB_DA_XML/DA83/3.3">
 <GAEBInfo>
  <Version>3.3</Version>
  <VersDate>2021-05</VersDate>
  <Date>2026-09-10</Date>
  <ProgName>Testexport</ProgName>
 </GAEBInfo>
 <PrjInfo>
  <NamePrj>TEST-041</NamePrj>
  <PrjID>TEST-041</PrjID>
  <LblPrj>Testprojekt Zeilenumbruch</LblPrj>
  <Cur>EUR</Cur>
 </PrjInfo>
 <Award>
  <DP>83</DP>
  <AwardInfo>
   <Cur>EUR</Cur>
  </AwardInfo>
  <OWN>
   <Address>
    <Name1>Muster AG</Name1>
   </Address>
  </OWN>
  <BoQ ID="ID_BOQ_041">
   <BoQInfo>
    <Name>LV-041</Name>
    <LblBoQ>LV Zeilenumbruch</LblBoQ>
    <BoQBkdn>
     <Type>BoQLevel</Type>
     <Length>2</Length>
     <Num>Yes</Num>
    </BoQBkdn>
    <BoQBkdn>
     <Type>Item</Type>
     <Length>4</Length>
     <Num>Yes</Num>
    </BoQBkdn>
   </BoQInfo>
   <BoQBody>
    <BoQCtgy ID="ID_CTGY_01" RNoPart="01">
     <LblTx>
      <p>
       <span>Technische Bearbeitung</span>
      </p>
     </LblTx>
     <BoQBody>
      <Itemlist>
       <Item ID="ID_ITEM_0010" RNoPart="0010">
        <LumpSumItem>Yes</LumpSumItem>
        <Qty>1.000</Qty>
        <QU>psch</QU>
        <Description>
         <CompleteText>
          <DetailTxt>
           <Text>
            <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
             <span style="font-family:Arial;font-size:10pt;">Unterlagen zusammenstellen.</span>
            </p>
            <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
             <span style="font-family:Arial;font-size:10pt;">Alle Pläne der Gewerke Rohbau, Ausbau,</span>
            </p>
            <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
             <span style="font-family:Arial;font-size:10pt;">Haustechnik und Außenanlagen beim Auftraggeber</span>
            </p>
            <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
             <span style="font-family:Arial;font-size:10pt;">anfordern und mit dem Bestand vor Ort abgleichen.</span>
            </p>
            <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;" />
            <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
             <span style="font-family:Arial;font-size:10pt;">Gilt für alle Bauzustände.</span>
            </p>
            <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;" />
            <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;" />
            <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;" />
           </Text>
          </DetailTxt>
          <OutlineText>
           <OutlTxt>
            <TextOutlTxt>
             <p>
              <span>Unterlagen zusammenstellen</span>
              <br />
              <span>Gewerke Rohbau bis Außenanlagen</span>
             </p>
            </TextOutlTxt>
           </OutlTxt>
          </OutlineText>
         </CompleteText>
        </Description>
       </Item>
       <Item ID="ID_ITEM_0020" RNoPart="0020">
        <LumpSumItem>Yes</LumpSumItem>
        <Qty>1.000</Qty>
        <QU>psch</QU>
        <Description>
         <CompleteText>
          <ComplTSA>Yes</ComplTSA>
          <DetailTxt>
           <Text>
            <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
             <span style="font-family:Arial;font-size:10pt;">Nachweise aufstellen. Lastannahmen nach</span>
            </p>
            <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
             <span style="font-family:Arial;font-size:10pt;">Vorgabe des Auftraggebers.</span>
            </p>
            <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
             <span style="font-family:Arial;font-size:10pt;">Unterlagen digital</span>
             <TextComplement MarkLbl="61" Kind="Owner">
              <ComplCaption />
              <ComplBody>
               <span style="font-family:Arial;font-size:10pt;">'-'</span>
              </ComplBody>
              <ComplTail>
               <span style="font-family:Arial;font-size:10pt;">zur Prüfung liefern und </span>
              </ComplTail>
             </TextComplement>
             <span style="font-family:Arial;font-size:10pt;">Anmerkungen einarbeiten.</span>
            </p>
            <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
             <span style="font-family:Arial;font-size:10pt;">Unterlagen nach Freigabe in Papierform</span>
            </p>
            <TextComplement MarkLbl="62" Kind="Owner">
             <ComplCaption />
             <ComplBody>
              <span style="font-family:Arial;font-size:10pt;">'(&gt;3&lt;)'</span>
             </ComplBody>
             <ComplTail>
              <span style="font-family:Arial;font-size:10pt;"> fach liefern. </span>
             </ComplTail>
            </TextComplement>
            <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
             <span style="font-family:Arial;font-size:10pt;">Bauwerk: Brücke.</span>
            </p>
           </Text>
          </DetailTxt>
          <OutlineText>
           <OutlTxt>
            <TextOutlTxt>
             <p>
              <span>Nachweise aufstellen</span>
             </p>
            </TextOutlTxt>
           </OutlTxt>
          </OutlineText>
         </CompleteText>
        </Description>
       </Item>
       <Item ID="ID_ITEM_0030" RNoPart="0030">
        <Qty>3.000</Qty>
        <QU>St</QU>
        <Description>
         <CompleteText>
          <DetailTxt>
           <Text>
            <p>
             <span>Lieferumfang:</span>
            </p>
            <p>
             <span>- Grundgerät</span>
            </p>
            <p>
             <span>- Befestigungsmaterial</span>
            </p>
            <p>
             <span>1. Prüfung vor Ort</span>
            </p>
            <p>
             <span>2. Abnahme</span>
            </p>
            <p>
             <span>Hersteller:</span>
             <br />
             <span>Typ:</span>
            </p>
            <p>
             <span>Angebotenes Fabrikat vom Bieter einzutragen,</span>
            </p>
            <p>
             <span>Vorhaltedauer ca.</span>
            </p>
            <p>
             <span>12 Wochen.</span>
            </p>
           </Text>
          </DetailTxt>
          <OutlineText>
           <OutlTxt>
            <TextOutlTxt>
             <p>
              <span>Gerät liefern</span>
             </p>
            </TextOutlTxt>
           </OutlTxt>
          </OutlineText>
         </CompleteText>
        </Description>
       </Item>
      </Itemlist>
     </BoQBody>
    </BoQCtgy>
   </BoQBody>
  </BoQ>
 </Award>
</GAEB>

{
  "permissions": {
    "allow": [
      "Bash(python -m pytest tests/ -x --tb=short --no-header -q)",
      "Bash(python3 -c ' *)",
      "Bash(python -m pytest tests/ --tb=short --no-header -q)",
      "Bash(python -c ' *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git mv *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint.sh",
            "args": [],
            "timeout": 30,
            "statusMessage": "Ruff + mypy..."
          }
        ]
      }
    ]
  },
  "codeExecutionPolicy": {
    "autoApprove": {
      "patterns": [
        "python -c.*",
        "python3 -c.*",
        "pytest.*",
        "ruff.*",
        "mypy.*"
      ]
    }
  }
}

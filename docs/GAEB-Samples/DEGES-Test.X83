        <Description ID="R20260504155625083000037">
         <StLNo Type="StLK">211172151401</StLNo>
         <WICNo>Teilleistungskatalog/117/ 2. 3.  1003. </WICNo>
         <CompleteText>
          <DetailTxt>
           <Text>
            <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
             <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Stahlspundwand ziehen. Spundwand nach Unterlagen des</span>
             <br/>
             <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">AG. Abgerechnet wird nach Länge in der Wandachse, hori-</span>
             <br/>
             <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">zontal, multipliziert mit der tatsächlichen Boh-</span>
             <br/>
             <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">lenlänge.</span>
             <br/>
             <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ziehen nach Wahl des AN.</span>
             <br/>
             <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bohlenlänge über 9,00 bis 12,00 m.</span>
             <br/>
             <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bohlen nach Wahl des AN verwerten.</span>
            </p>
           </Text>
          </DetailTxt>
          <OutlineText>
           <OutlTxt>
            <TextOutlTxt>
             <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
              <span>Stahlspundwand ziehen</span>
              <br/>
              <span>ziehen Wahl d. AN*Länge ü. 9-12 m</span>
              <br/>
              <span>Bohlen verwerten</span>
             </p>
            </TextOutlTxt>
           </OutlTxt>
          </OutlineText>
          <!-- GAEB version used: 330 -->
          <!-- GAEB version used: 330 -->
         </CompleteText>
        </Description>
       </Item>

        <Description ID="R20260504155625092000038">
         <StLNo Type="StLK">2111722501</StLNo>
         <WICNo>Teilleistungskatalog/117/ 2. 4.  1000. </WICNo>
         <CompleteText>
          <DetailTxt>
           <Text>
            <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
             <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Stahlspundwand säubern. Anhaftenden Boden von freige-</span>
             <br/>
             <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">legter Fläche der Stahlspundwand entfernen. Abgerechnet</span>
             <br/>
             <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">wird nach Länge in der Wandachse, horizontal, multipli-</span>
             <br/>
             <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ziert mit der freigelegten Höhe.</span>
             <br/>
             <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Spundwand für Baugrubenverbau.</span>
            </p>
           </Text>
          </DetailTxt>
          <OutlineText>
           <OutlTxt>
            <TextOutlTxt>
             <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
              <span>Stahlspundwand säubern</span>
              <br/>
              <span>Baugrubenverbau</span>
             </p>
            </TextOutlTxt>
           </OutlTxt>
          </OutlineText>
          <!-- GAEB version used: 330 -->
          <!-- GAEB version used: 330 -->
         </CompleteText>
        </Description>
       </Item>
      </Itemlist>
     </BoQBody>
    </BoQCtgy>
    <BoQCtgy ID="AAAAAAABIDIHAAAA" RNoPart="2">
     <LblTx>
      <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
       <span>Ing.Bauten aus Beton und Stahlbeton</span>

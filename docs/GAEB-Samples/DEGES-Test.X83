        <Description ID="R20260504155625102000040">
         <StLNo Type="StLK">21118318112200</StLNo>
         <WICNo>Teilleistungskatalog/118/ 1. 1. 1024. </WICNo>
         <CompleteText>
          <DetailTxt>
           <Text>
            <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
             <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bewehrten Beton in Schalung nach Unterlagen des AG her-</span>
             <br/>
             <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">stellen. Schalung, Bewehrung und Traggerüst der Bemes-</span>
             <br/>
             <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">sungsklasse B werden gesondert vergütet.</span>
             <br/>
             <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bauteil = Fundament.</span>
             <br/>
             <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Art der Verwendung = Stahlbeton.</span>
             <br/>
             <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Druckfestigkeitsklasse C20/25.</span>
             <br/>
             <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Expositionsklasse XC2 und XA1.</span>
            </p>
           </Text>
          </DetailTxt>
          <OutlineText>
           <OutlTxt>
            <TextOutlTxt>
             <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
              <span>Bew. Beton herst., Schalung gesond.</span>
              <br/>
              <span>Fundament*Stahlbeton</span>
              <br/>
              <span>C20/25*XC2 und XA1</span>
             </p>
            </TextOutlTxt>
           </OutlTxt>
          </OutlineText>
          <!-- GAEB version used: 330 -->
          <!-- GAEB version used: 330 -->
         </CompleteText>
        </Description>
       </Item>

   <BoQBody>
    <BoQCtgy ID="AAAAAAABIDIGAAAA" RNoPart="1">
     <LblTx>
      <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
       <span>Gründungen</span>
      </p>
     </LblTx>
     <BoQBody>
      <Itemlist>
       <Item ID="AAAAAAABIDIGBEAA" RNoPart="10">
        <Qty>657.540</Qty>
        <QtySplit>

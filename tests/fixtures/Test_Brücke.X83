         <Item ID="AAAAAAABIECHHENA" RNoPart="90">
          <Qty>2.000</Qty>
          <QU>St</QU>
          <Description ID="R20220517091608168000002">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Geräte für Trägerbohlwand nach Unterlagen des AG ein-</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">setzen. Der Einsatz umfasst das Aufstellen und Abbauen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">sowie das Umsetzen im Bereich des Bauteils.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bauteil = gesamtes Bauwerk.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Arbeitsplanum herstellen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Geräte für geringe Arbeitsbreiten in Achse 20 gemäß Unterlagen des AG.  </span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Geräteeinsatz für Trägerbohlwand</span>
                <br/>
                <span>Bauwerk</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>

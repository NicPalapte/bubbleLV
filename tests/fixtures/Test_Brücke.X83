          </Description>
         </Item>
         <Item ID="AAAAAAABIEHKEHPA" RNoPart="50">
          <Qty>250.000</Qty>
          <QU>m2</QU>
          <Description ID="R20240103193122983000672">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Düngen mit organischem Dünger</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Nach dem Lockern ist die Fläche mit</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Hornspäne 50g/m2 zu düngen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Düngen mit organischem Dünger</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEHKGCHI" RNoPart="60">
          <Qty>50.000</Qty>
          <QU>m2</QU>
          <Description ID="R20240103193122986000673">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Selektiver Rückschnitt, Stauden, Fertigstellungspflege</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Leistungen zur Fertigstellung in der ersten</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Vegetationsperiode bis zur Abnahme.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Selektiver Rückschnitt, Remontierschnitt</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">zur Förderung der Nachblüte oder Entwicklung</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">einzelner Stauden nach Angabe,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">in nicht zusammenhängenden Flächen,</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">in einem Arbeitsgang,</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Schnittgut aufnehmen und einer fachgerechten Wiederverwendung oder Entsorgung zuzuführen,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">einschließlich der Verwertungskosten.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bei den Pflegearbeiten wird eine entspreched dem</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">repräsentativen Erscheinungbild der Pflanzflächen</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">qualifizierte gärtnerische Pflege verlangt.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Anwesenheit einer ausgebildeten, für die</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">auszuführende Tätigkeit erfahrenen Fachkraft während</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">der Pflegearbeiten ist zwingend erforderlich.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Jeder Pflegegang ist rechtzeitig der Bauüberwachung</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">anzukündigen. Der Pflegebericht ist unverzüglich nach</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ausführung der Bauüberwachung (E-Mail, Telefax)</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">vorzulegen und gegenzeichnen zu lassen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Abrechnung nach ausgeführten, mit bestätigtem</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Pflegebericht nachgewiesenen Einheiten.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">EP für 1 Arbeitsgänge</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Selektiver Rückschnitt, Stauden, Fertigstellungspflege</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEHKHPNA" RNoPart="70">
          <Qty>250.000</Qty>
          <QU>m2</QU>
          <Description ID="R20240103193122991000674">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Laub entfernen, Fertigstellungspflege</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Leistungen zur Fertigstellung in der ersten</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Vegetationsperiode,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Laub entfernen auf Pflanzflächen,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">in nicht zusammenhängenden Teilflächen,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ausführung nach vollständigem Laubfall</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">bis spätestens Ende November</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Laub, Unrat in kleinen Mengen sind einer fachgerechten Wiederverwendung oder Entsorgung zuzuführen,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">einschließlich der Verwertungskosten.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Der Pflegegang ist rechtzeitig der Bauüberwachung</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">anzukündigen. Der Pflegebericht ist unverzüglich nach</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ausführung der Bauüberwachung persönlich oder</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">per E-Mail bzw. Telefax vorzulegen und gegenzeichnen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">zu lassen. Abrechnung nur nach ausgeführten, mit</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">bestätigtem Pflegebericht nachgewiesenen Einheiten.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">EP für 1 Arbeitsgänge</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Laub entfernen, Fertigstellungspflege</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
      <BoQCtgy ID="AAAAAAABIEHKKEKI" RNoPart="61">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Entwicklungspflege 2 Jahre</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Item ID="AAAAAAABIEHKKNNI" RNoPart="10">
          <Qty>4.000</Qty>
          <QU>St</QU>
          <Description ID="R20240103193123000000676">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Pflege Bäume</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Pflege Bäume</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bäume wie folgt pflegen:</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(71,71,71);">Für die Ausführung der Pflegearbeiten</span>
               <span style="font-family:@Arial Unicode MS;text-decoration:underline;font-size:10pt;Color:rgb(71,71,71);"> </span>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(71,71,71);">als Entwicklungspflege gelten DIN 18919, . </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Locker gewordene und ausgerissene Baumböcke</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">sind wieder zu befestigen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Beschädigungen am Verdunstungsschutz sind</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">auszubessern. </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Trockene und sich reibende Äste sind zu entfernen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Wenn nötig ist der Auslichtungsschnitt nachzuholen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Beschädigungen am Stamm sind fachgerecht zu</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">behandeln.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Schwach wachsende Leittriebe sind zu stäben und</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">entsprechend dem Zuwachs nach zu binden.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bei leichtem Befall der Rotpustelkrankheit sind die</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">befallenen Stellen auszuschneiden. </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Abgestorbene Bäume, deren Kronenaufbau durch</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">abgestorbene Äste nicht der DIN-Norm entsprechen und</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bäume die keinen artgerechten Blattaustrieb gebildet</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">haben, sind zu ersetzen. Im Anschluss startet die</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Pflege von Neuem. </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Leistung versteht sich einschl. Entsorgung anfallenden Materials.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Fertigstellungspflege endet mit der Abnahme der Pflanzung/Pflanzflächen nach ca. 1 jähriger Fertigstellungspflege. </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Der Einheitspreis bezieht sich auf die vorgesehene Anzahl der Pflegegänge</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Abrechnung nach tatsächlich durchgeführten Arbeitsgängen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">1 Arbeitsgang pro Baum pro Jahr sind vorab vorgesehen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Preis pro Arbeitsgang je Baum:  &#x27; ...     &#x27; </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Preis für 2 Arbeitsgänge.  &#x27;          &#x27; </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">(dieser Preis ist als EP einzusetzen)</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Pflege Bäume</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEHKMMMI" RNoPart="20">
          <Qty>250.000</Qty>
          <QU>m2</QU>
          <Description ID="R20240103193123004000677">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Pflege Baumscheiben/Baumunterpflanzung</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Pflege Staudenpflanzung und Baumunterpflanzung</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Für die Ausführung der Pflegearbeiten</span>
               <span style="font-family:@Arial Unicode MS;text-decoration:underline;font-size:10pt;Color:rgb(0,0,0);">, </span>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">als Fertigstellungspflege gelten </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">DIN 18916, DIN 18917. </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Pflanzflächen sind unkrautfrei halten, dauerhafte Wurzelunkräuter </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">ausstechen,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Steine über 5 cm D sind zu entfernen,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Lockerungen vorsichtig um Wurzeln der Bodendecker und Baumneupflanzung und Altbestand Bäume nicht zu beschädigen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Unrat, Müll und Steine über 6 cm Durchmesser und</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Unkraut sind zu entfernen und ordnungsgemäß zu entsorgen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Zum jeweiligen Pflegetermin sind auch Rückschnitte von Verblühten Stauden einzukalulieren.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Anwendung von Herbiziden ist nicht zulässig.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Der Einheitspreis bezieht sich auf 12 Pflegegänge</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Abrechnung nach tatsächlich durchgeführten Arbeitsgängen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">12 Arbeitsgänge sind vorab vorgesehen in den 2 Jahren Entwicklungspflege</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Preis pro Arbeitsgang je Baumscheibe:  &#x27; ...     &#x27; </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Preis für 12 Arbeitsgänge.  &#x27;          &#x27; </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">(dieser Preis ist als EP einzusetzen)</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Pflege Baumscheiben/Baumunterpflanzung</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEHKOKCI" RNoPart="30">
          <Qty>4.000</Qty>
          <QU>St</QU>
          <Description ID="R20240103193123008000678">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Wässern Bäume</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Wässern Bäume</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Mindestwassermenge je Arbeitsgang 120 l / Baum.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">in 2 Gaben.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Benötigtes Wasser ist zu liefern</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Abrechnung nach tatsächlich durchgeführten</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Arbeitsgängen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">18 Arbeitsgänge pro Baum sind vorab vorgesehen.(10 im 1.Jahr und 8 im 2. Jahr)</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Preis pro Arbeitsgang je Baum:  &#x27; ...     &#x27; ?</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Preis für 18 Arbeitsgänge pro Baum  &#x27;          &#x27; (dieser Preis ist als EP einzusetzen)</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Wässern Bäume</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEFOAHAI" RNoPart="40">
          <Qty>250.000</Qty>
          <QU>m2</QU>
          <Description ID="R20240103193123013000679">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Wässern Staudenpflanzung</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">WässernStaudenpflanzung</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Mindestwassermenge je Arbeitsgang 5 l / m²</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Abrechnung nach tatsächlich durchgeführten</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Arbeitsgängen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">8 Arbeitsgänge sind vorab vorgesehen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Preis pro Arbeitsgang je m²:  &#x27; ...     &#x27; ?</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Preis für 8 Arbeitsgänge.  &#x27;          &#x27; (dieser Preis ist als EP einzusetzen)</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Wässern Staudenpflanzung</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEFOCBAI" RNoPart="50">
          <Qty>250.000</Qty>
          <QU>m2</QU>
          <Description ID="R20240103193123017000680">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Fläche düngen mit organischem Dünger</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Fläche düngen mit organischem Dünger</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Nach dem Lockern ist die Fläche mit</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Hornspäne 50g/m2 zu düngen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">EP für 1 Pflegang pro Jahr = 2 Pflehgegänge</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Fläche düngen mit organischem Dünger</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEFODLPA" RNoPart="60">
          <Qty>80.000</Qty>
          <QU>m2</QU>
          <Description ID="R20240103193123021000681">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Selektiver Rückschnitt, Stauden, Entwicklungspflege</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Leistungen zur Fertigstellung in der ersten</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Vegetationsperiode bis zur Abnahme.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Selektiver Rückschnitt, Remontierschnitt</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">zur Förderung der Nachblüte oder Entwicklung</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">einzelner Stauden nach Angabe,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">in nicht zusammenhängenden Flächen,</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">in einem Arbeitsgang,</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Schnittgut aufnehmen und einer fachgerechten Wiederverwendung oder Entsorgung zuzuführen,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">einschließlich der Verwertungskosten.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bei den Pflegearbeiten wird eine entspreched dem</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">repräsentativen Erscheinungbild der Pflanzflächen</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">qualifizierte gärtnerische Pflege verlangt.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Anwesenheit einer ausgebildeten, für die</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">auszuführende Tätigkeit erfahrenen Fachkraft während</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">der Pflegearbeiten ist zwingend erforderlich.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Jeder Pflegegang ist rechtzeitig der Bauüberwachung</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">anzukündigen. Der Pflegebericht ist unverzüglich nach</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ausführung der Bauüberwachung (E-Mail, Telefax)</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">vorzulegen und gegenzeichnen zu lassen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Abrechnung nach ausgeführten, mit bestätigtem</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Pflegebericht nachgewiesenen Einheiten.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">EP für 1 Arbeitsgänge</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Selektiver Rückschnitt, Stauden, Entwicklungspflege</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEFOFJKI" RNoPart="70">
          <Qty>250.000</Qty>
          <QU>m2</QU>
          <Description ID="R20240103193123026000682">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Laub entfernen, Entwicklungspflege</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Leistungen zur Entwicklungspflege,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Laub entfernen auf Pflanzflächen,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">in nicht zusammenhängenden Teilflächen,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ausführung nach vollständigem Laubfall</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">bis spätestens Ende November</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Laub, Unrat in kleinen Mengen sind einer fachgerechten Wiederverwendung oder Entsorgung zuzuführen,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">einschließlich der Verwertungskosten.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Der Pflegegang ist rechtzeitig der Bauüberwachung</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">anzukündigen. Der Pflegebericht ist unverzüglich nach</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ausführung der Bauüberwachung persönlich oder</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">per E-Mail bzw. Telefax vorzulegen und gegenzeichnen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">zu lassen. Abrechnung nur nach ausgeführten, mit</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">bestätigtem Pflegebericht nachgewiesenen Einheiten.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">1 Pflegegang/Jahr: ....</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">EP für 2 Pflegegänge:.........</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Laub entfernen, Entwicklungspflege</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
      <BoQCtgy ID="AAAAAAABIEFOHOMI" RNoPart="62">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Arbeitskräfte</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Remark ID="AAAAAAABIEFOIIAA">
          <Description ID="R20240103193123032000684">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;text-decoration:underline;font-size:10pt;Color:rgb(0,0,0);">Vorbemerkungen</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Stundenlohnarbeiten durch Arbeitskräfte und Baugeräte sind nur auf</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">besondere Anordnung des AG ausführen.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die angebotenen Stundensätze werden auch bei Nachtragspositionen</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">berücksichtigt und beinhalten zugehörige Allgemeinkosten.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;text-decoration:underline;font-size:10pt;Color:rgb(0,0,0);">Stundenlohnarbeiten</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Der Verrechnungssatz für die jeweilige Arbeitskraft umfasst sämtliche Auf-</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">wendungen, insbesondere den tatsächlichen Lohn einschl. vermögens-</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">wirksamer Leistungen mit den Zuschlägen für Gemeinkosten (Sozial-</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">kassen-beiträge, Winterbauumlage und dgl.) sowie Gehaltsnebenkosten</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">und Zuschläge für Überstunden.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Zuschläge für Über-, Nacht-, Sonntags- und Feiertagsarbeit werden nach</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">den jeweils geltenden tariflichen Festlegungen gesondert vergütet.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;text-decoration:underline;font-size:10pt;Color:rgb(0,0,0);">Baugeräte</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Der Verrechnungssatz für das jeweilige Gerät umfasst sämtliche Aufwend-</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">ungen für den Einsatz,  insbesondere Gerätevorhalte- und Betriebsstoffkosten</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">sowie sämtliche Zuschläge einschliesslich der Kosten für den Geräteführer.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Der Verrechnungssatz gilt für das zum Zeitpunkt des Abrufes einsatzbereit</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">auf der Baustelle befindliche Baugerät. Vergütet werden die angefangenen Stunden zwischen Einsatzbeginn und -ende, jedoch ohne Reparatur- und</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Wartungszeiten.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Zuschläge für Über-, Nacht-, Sonntags- und Feiertagsarbeit des Geräteführers werden nach den jeweils geltenden tariflichen Festlegungen gesondert vergütet.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Vorbemerkungen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Remark>

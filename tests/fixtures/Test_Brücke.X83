      <BoQCtgy ID="AAAAAAABIEGDPFNA" RNoPart="17">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Strassenablauf ausbauen</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Item ID="AAAAAAABIEGFAAAA" RNoPart="10">
          <Qty>6.000</Qty>
          <QU>St</QU>
          <Description ID="R20240103193121623000419">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Straßenablauf freilegen, ausbauen, laden und entsorgen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Straßenablauf (Nass-Schlamm) einschließlich Aufsatz vollständig ausbauen und entsorgen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Aufsatz: 300 x 500 mm und 500 x 500 mm</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Gesamtbauhöhe: bis 2000 mm</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Straßenablauf aus Betonfertigteilen in befestigter oder unbefestigter Oberfläche.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Anschlussleitungen nach Angabe des AG soweit erforderlich abdichten.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Erdarbeiten unterhalb der Leitungsanschlüsse in Boden des Homogenbereiches gem. Baugrunderkundung ausführen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Sämtliche Stoffe und Aushub aufnehmen, transportieren und einer fachgerechten Verwertung zuführen. </span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Straßenablauf freilegen, ausbauen, laden und entsorgen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEGFBKPI" RNoPart="20">
          <Qty>5.000</Qty>
          <QU>m3</QU>
          <Description ID="R20240103193121633000420">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Straßenablauf verfüllen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Boden für Ausbauvolumen im Bereich von entferntem Straßenablauf liefern, </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">lagenweise einbauen und verdichten.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Boden: Kies-Sandgemisch</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Sieblinie der Lieferkörnung: 0/32 mm</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Tiefe des entfernten Straßenablaufes: bis 2,00 m</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Straßenablauf verfüllen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
      <BoQCtgy ID="AAAAAAABIEGFDOII" RNoPart="18">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Sichern von Leitungen</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Remark ID="AAAAAAABIEGFEHMA">
          <Description ID="R20240103193121633000422">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;text-decoration:underline;font-size:10pt;Color:rgb(0,0,0);">Vorbemerkungen</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:justify;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Leitungen und Kabel vorsichtig durch Handschachtung gemäß Kabelschutzanweisung aufsuchen, Kabelschutz aus unterschiedlichem Material aufnehmen und zwischenlagern, Leitung ringsum freilegen, aufhängen, abstützen oder</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">umlegen, für die Dauer der Bauarbeiten, auch in Einzelabschnitten.</span>
              </p>
              <p style="text-align:justify;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:justify;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Wenn mit Abweichungen der Leitungen von der bezeichneten Leitungstrasse gerechnet werden muss, gelten die gleichen Vorsichtsmaßnahmen auch neben der vermuteten Leitungstrasse.</span>
              </p>
              <p style="text-align:justify;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:justify;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Mit Abschluss der Arbeiten sind die Versorgungsleitungen wieder fachgerecht im Leitungsgraben zu verlegen, abzusanden (Kabelsand 0/2 bis 0/4) und mit Kabelschutz und Trassenwarnbändern abzudecken.</span>
              </p>
              <p style="text-align:justify;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Eventuell erforderliche Einmessarbeiten sind vom AN rechtzeitig beim VU anzuzeigen.</span>
              </p>
              <p style="text-align:justify;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Versorgungsleitungen:</span>
              </p>
              <ul style="font-family:Symbol;font-size:10pt;Color:rgb(0,0,0);">
               <li>
                <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Kabel und Rohre aus verschiedenen Materialien</span>
               </li>
               <li>
                <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">unter Druck stehend</span>
               </li>
               <li>
                <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">unter Spannung stehend</span>
               </li>
               <li>
                <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Durchmesser bis 200 mm</span>
               </li>
               <li>
                <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Aushubtiefe bis 1,00 m unter Gradientenhöhe der Verkehrsfläche</span>
               </li>
               <li>
                <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Querende Leitungen bis zu einer Länge von  5,00 m</span>
               </li>
              </ul>
              <p style="text-align:justify;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:justify;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Es sind alle vorstehenden Arbeiten und sonstige Erschwernisse bei den Erd- und Verbauarbeiten, z.B. Handschachtung und Sicherungsmaßnahmen, in die Einheitspreise einzurechnen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Vorbemerkungen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Remark>
         <Item ID="AAAAAAABIEGFFJDI" RNoPart="10">
          <Qty>22.000</Qty>
          <QU>m</QU>
          <Description ID="R20240103193121643000423">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Freilegen und Sichern von Versorgungsleitungen, Handschachtung, quer</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Freilegen und Sichern der beim Straßenaufbruch bzw. Bodenaushub vorgefundenen, kreuzenden oder schräg zur Baugrube/Baufeld verlaufenden Versorgungsleitungen durch Handschachtung (Gas-, Strom-, Wasser-, Fernmelde-, Fernwärmeleitungen etc.).</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Vor Beginn der Arbeiten hat sich der AN bei den Versorgungsunternehmen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">(VU) über die Lage der Leitungen und der Sicherheitsvorkehrungen zu erkundigen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Mehrere nebeneinander liegende Versorgungsleitungen, auch unterschiedlicher Transportmedien, bis 3 Stück innerhalb eines Streifens von 0,50 m lichter Breite, sowie gebündelte Leitungen oder mehrere Leitungen in Formsteinen werden als eine Leitung abgerechnet.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Für die Abrechnung der Leistungen gilt die Voraussetzung, dass die Leitungskreuzungen nach Lage und Anzahl, sowie mit Angabe der Art der Leitungen und</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Kabel und Bezeichnungen des jeweiligen VU in Aufmaßskizzen nachzuweisen sind.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Diese Nachweise sind der Bauleitung umgehend zur Anerkennung vorzulegen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Bauleitung behält sich vor, eine Bestätigung der Erfordernisse der Leistung seitens des zuständigen VU zu verlangen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Der AN haftet auch nach Verfüllung und Verdichtung für einen ordnungs-</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">gemäßen Zustand, auch dann, wenn Schäden erst nach Beendigung der</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Arbeiten auftreten.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Freilegen und Sichern von Versorgungsleitungen, Handschachtung, quer</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEGFHGOA" RNoPart="20">
          <Qty>142.000</Qty>
          <QU>m</QU>
          <Description ID="R20240103193121651000424">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Freilegen und Sichern von Versorgungsleitungen, Handschachtung, längs</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Freilegen und Sichern der beim Straßenaufbruch bzw. Bodenaushub vorgefundenen Versorgungsleitungen durch Handschachtung (Gas-, Strom-,  Wasser-, Fernmelde-, Fernwärmeleitungen etc.).</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Vor Beginn der Arbeiten hat sich der AN bei den Versorgungsunternehmen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">(VU) über die Lage der Leitungen und der Sicherheitsvorkehrungen zu er-</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">kundigen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Mehrere nebeneinander liegende Versorgungsleitungen, auch unterschiedlicher Transportmedien, bis 3 Stück innerhalb eines Streifens von 0,50 m lichter </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Breite, sowie gebündelte Leitungen oder mehrere Leitungen in Formsteinen werden als eine Leitung abgerechnet.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Für die Abrechnung der Leistungen gilt die Voraussetzung, dass die Leitungen nach Lage und Anzahl, sowie mit Angabe der Art der Leitungen und Kabel und Bezeichnungen des jeweiligen VU in Aufmaßskizzen nachzuweisen sind.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Diese Nachweise sind der Bauleitung umgehend zur Anerkennung vorzulegen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Bauleitung behält sich vor, eine Bestätigung der Erfordernisse der Leistung seitens des zuständigen VU zu verlangen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Der AN haftet auch nach Verfüllung und Verdichtung für einen ordnungsgemäßen Zustand, auch dann, wenn Schäden erst nach Beendigung der Arbeiten auftreten.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Freilegen und Sichern von Versorgungsleitungen, Handschachtung, längs</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
      <BoQCtgy ID="AAAAAAABIEGFJNAI" RNoPart="19">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Sichern und Regulieren von Einbauten</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Item ID="AAAAAAABIEGFKGEA" RNoPart="10">
          <Qty>10.000</Qty>
          <QU>St</QU>
          <Description ID="R20240103193121662000426">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Lichtschachtabdeckung regulieren, bis 1,00 m²</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Vorhandene Lichtschachtabdeckung bis 1,00 m² Größe schonend freilegen,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">aufnehmen, säubern, im Bereich der Baustelle sicher lagern und später</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">entsprechend der neuen Höhenlage wieder versetzen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Lichtschachtabdeckung aus Rost, Rahmen, Verankerungen und Auflager </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Höhe des aufzunehmenden Auflagers: bis zu 20 cm</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">vorhandenes Auflager: Betonring/-kranz und/oder Ziegelmauerwerk</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die vorhandenen oder gelieferten Lichtschachtabdeckungen werden</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">einschl. Verankerung neu verlegt.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Das neu herzustellende Auflager der Lichtschachtabdeckung sowie die</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">unmittelbar umgebende Pflaster- bzw. Plattenreihe des Gehweges sind</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">auf Frischbeton C30/37, XF 4 zu verlegen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Zur fluchtgleichen Ausbildung des Betonkranzes zur Schachtinnenseite</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">hin ist eine Schalung vorzusehen. </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">In den EP einzurechnen sind evtl. erforderlich werdende Änderungen der</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Verankerung, kleinere Instandsetzungen der bei der Aufnahme entstandenen Beschädigungen an der Lichtschachtabdeckung, Erdarbeiten, sowie die</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Lieferung aller Materialien durch den AN.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Lichtschachtabdeckung regulieren, bis 1 m²</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEGFMDLI" RNoPart="20">
          <Qty>29.000</Qty>
          <QU>St</QU>
          <Description ID="R20240103193121664000427">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Armaturen sichern</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Armaturen der vorhandenen Versorgungsleitungen einschl. Gestänge,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">für die Dauer der Bauzeit vor Beschädigungen sichern.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bei Ausführung der neuen Befestigung sind die Straßenkappen der</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Hydranten und Schieber nach Anweisung der VU fachgerecht wieder</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">einzubauen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Verdichtung im Bereich um die eingesetzte Armatur hat besonders</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">sorgfältig zu erfolgen, um spätere Setzungen zu vermeiden.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Funktionstüchtigkeit wird nach dem Einbau durch das VU überprüft.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Werden dabei Mängel festgestellt, ist die Armatur freizulegen und nach</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Anweisung des VU neu einzubauen. Sämtliche Kosten, auch die für den</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ersatz der Armatur gehen dabei zu Lasten des AN.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Alle Erschwernisse, u.a. solche aus Freilegen der Schieber in Hand-</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">schachtung, sind in den Einheitspreis einzurechnen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Armaturen sichern</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEGFNPPI" RNoPart="30">
          <Qty>7.000</Qty>
          <QU>St</QU>
          <Description ID="R20240103193121672000428">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Schachtbauwerke sichern</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Im Baufeld vorhandene Schachtbauwerke, aus Mauerwerk oder Betonfertigteilen, während der gesamten Arbeiten bis zur Fertigstellung der Fahrbahnoberflächen und Nebenanlagen sichern.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Sollte das Schachtbauwerk trotz Sicherung beschädigt werden, ist der Schaden durch den AN zu beheben. Die beschädigten Bauteile sind aufzunehmen, zu beseitigen und in Abstimmung mit dem AG durch Mauerwerk bzw. baugleiche Fertigteile zu erneuern. Einzukalkulieren sind alle Kosten und Nebenarbeiten.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schachtbauwerke sichern</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEGCAAAA" RNoPart="40">
          <Qty>15.000</Qty>
          <QU>St</QU>
          <Description ID="R20240103193121674000429">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Schieber- und Hydrantenkappen in Pflasterflächen regulieren</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Schieberkappen (Gas-, Wasser-) und Hydrantenkappen, in Pflaster- oder </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Plattenflächen, Höhendifferenz bis zu +/- 20 cm, regulieren.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">In den Einheitspreis sind alle erforderlichen Anpassungs- und Erdarbeiten einzurechnen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Unbrauchbare Materialien in Eigentum des AN übernehmen und einer fachgerechten Verwertung zuführen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Arbeiten an den Gestängen werden von Fachkräften des Versorgungsunternehmens (NEW) vorgenommen, der AN hat das VU frühzeitig zu informieren.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schieber- und Hydrantenkappen in Pflasterflächen regulieren</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEGCBGPI" RNoPart="50">
          <Qty>13.000</Qty>
          <QU>St</QU>
          <Description ID="R20240103193121684000430">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Schieber- und Hydrantenkappen in Asphaltflächen regulieren</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Schieberkappen (Gas-, Wasser-) und Hydrantenkappen, in bituminierten Verkehrsflächen, Höhendifferenz bis zu +/- 20 cm, regulieren.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">In den Einheitspreis sind alle erforderlichen Anpassungs- und Erdarbeiten </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">einzurechnen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Unbrauchbare Materialien in Eigentum des AN übernehmen und einer </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">fachgerechten Verwertung zuführen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Arbeiten an den Gestängen werden von Fachkräften des Versorgungsunternehmens (NEW) vorgenommen, der AN hat das VU frühzeitig zu informieren.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schieber- und Hydrantenkappen in Asphaltflächen regulieren</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEGCDCLA" RNoPart="60">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <Description ID="R20240103193121684000431">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Abdeckungen für Kanalschächte im Pflasterfläche regulieren</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Abdeckungen für Kanalschächte, in Pflaster- oder Plattenflächen, auf endgültige Höhe der Verkehrsfläche unter Verwendung von Auflageringen und Mörtel </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">MG III regulieren.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ausführung: rund oder rechteckig</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Höhendifferenz: bis zu +/- 20 cm</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">In den Einheitspreis ist der Aufbruch der vorhandenen Befestigung und die Lieferung sämtlicher Materialien bzw. die fachgerechte Entsorgung anfallender Materialien, einzurechnen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Aufbruch vor dem Einbau der Deckschicht mit Fertigbeton C 20/25 schließen und verdichten.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Vorhandene Wandungen säubern, soweit erforderlich trocknen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Abdeckungen für Kanalschächte in Pflasterflächen regulieren</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
      <BoQCtgy ID="AAAAAAABIEGCFHLI" RNoPart="20">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Straßenausstattung entfernen</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Item ID="AAAAAAABIEGCGAPA" RNoPart="10">
          <Qty>2.000</Qty>
          <QU>St</QU>
          <Description ID="R20240103193121694000433">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einbauteile aus Rohrgeländer aufnehmen und lagern</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einbauteile aus Rohrgeländer (z.B. Handlauf, Kniegurt, Pfosten, Fahrradbügel und Baumschutzbügel einschl. 2 Fundamenten) aufnehmen und im Baustellenbereich lagern.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Höhe: bis 1,00 m</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Fundamente entsorgen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Übriges Aufbruchgut in Eigentum des AN übernehmen, von der Baustelle entfernen und einer fachgerechten Verwertung zuführen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Einbauteile aus Rohrgeländer aufnehmen und lagern</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEGCHMJI" RNoPart="20">
          <Qty>8.000</Qty>
          <QU>St</QU>
          <Description ID="R20240103193121704000434">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Absperrpfosten aufnehmen und lagern</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Absperrpfosten einschl. evtl. vorhandenen Ketten, Hülsen und Fundamenten aufnehmen und im Baustellenbereich lagern.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Material: Holz, Beton oder Stahl</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Pfostenhöhe: &#x3c; 1,20 m über OK Gelände</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Fundamente und übriges Aufbruchgut in Eigentum des AN übernehmen, von der Baustelle entfernen und einer fachgerechten Verwertung zuführen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Absperrpfosten aufnehmen und lagern</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEGCJHLI" RNoPart="30">
          <Qty>25.000</Qty>
          <QU>St</QU>
          <Description ID="R20240103193121705000435">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Verkehrszeichenpfosten aufnehmen und lagern</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Verkehrszeichenpfosten einschl. Betonfundament aufnehmen und im Baustellenbereich lagern.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Material: Stahl</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Pfostenhöhe: bis 4,50 m über OK Gelände.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Fundament und übriges Aufbruchgut in Eigentum des AN übernehmen, von der</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Baustelle entfernen und einer fachgerechten Verwertung zuführen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Verkehrszeichenpfosten aufnehmen und lagern</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEGCLCNI" RNoPart="40">
          <Qty>51.000</Qty>
          <QU>St</QU>
          <Description ID="R20240103193121714000436">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Verkehrszeichen demontieren und lagern</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">

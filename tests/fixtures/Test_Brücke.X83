          <Qty>277.400</Qty>
          <QU>m2</QU>
          <Description ID="R20220512122658775000003">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Beton nach Unterlagen des AG abbrechen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bauteil Gehweg </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Material Beton mit geringer Bewehrung,</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einstufung in Z2 nach LAGA Recyclingbaustoffe </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Druckfestigkeitsklasse bei der Herstellung B225 entspricht etwa einem C20/25.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Eine Zunahme der Endfestigkeit über die Standzeit ist anzunehmen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Abbruchdicke  12cm</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Abbruch ohne Erschütterungen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Beton in Teilbereichen abbrechen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Abbruchgut der Verwertung nach Wahl des AN zuführen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Beton abbrechen. Ohne .Erschütterung*Teilbereiche Verwerten</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>

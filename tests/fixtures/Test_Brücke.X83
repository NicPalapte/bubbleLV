         <Item ID="AAAAAAABIECIECMA" RNoPart="100">
          <Qty>250.000</Qty>
          <QU>m2</QU>
          <Description ID="R20230816180143632000004">
           <StLNo Type="StLK">181061521002</StLNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Oberboden liefern und profilgerecht andecken. Abgerech-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">net werden die angedeckten Flächen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Andeckung auf Böschungen. Vorhandene Böschung vor Auf-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">trag des Oberbodens aufrauen und mit Rillen versehen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Dicke der Andeckung = 10 cm.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Oberboden liefern und andecken</span>
                <br/>
                <span>Böschungen*Andeckung 10 cm</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>

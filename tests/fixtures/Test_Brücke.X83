         <Item ID="AAAAAAABIECHBJAI" RNoPart="10">
          <Qty>37.000</Qty>
          <QU>m2</QU>
          <Description ID="R20220518154022607000009">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Pflasterdecke mit Pflasterziegeln herstellen. Farbe und</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Oberflächeneigenschaften nach Unterlagen AG. Rutschwi-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">derstand mindestens U2.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">In 30 cm breiter Pflasterstreifen neben Flügelwänden</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Pflasterziegel aus Verwertung von Mauerwerksabbruch von Bestandsbrücke </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ziegel als Flachschicht im Block-/Parkettverband verle-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">gen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bettung in 10 cm Beton </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Fuge mit Baustoffgemisch 0/4.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Pflasterd. m. Pflasterziegel herst.</span>
                <br/>
                <span>Blockverb. flach, Fuge 0/4</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIECHCBGA" RNoPart="20">
          <Qty>25.000</Qty>
          <QU>m2</QU>
          <Description ID="R20210624070710936000006">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Pflasterdecke mit Pflasterziegeln herstellen. Farbe und</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Oberflächeneigenschaften nach Unterlagen AG. Rutschwi-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">derstand mindestens U2.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">In Bermen vor Widerlagern</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Pflasterziegel aus Verwertung von Mauerwerksabbruch von Bestandsbrücke</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ziegel als Rollschicht im Läufer- oder Reihenverband</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">verlegen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bettung in 10 cm Beton </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Fuge mit Baustoffgemisch 0/4.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Pflasterd. m. Pflasterziegel herst.</span>
                <br/>
                <span>Läufer, Rollsch. Fuge 0/4</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIECHCJLI" RNoPart="30">
          <Qty>16.000</Qty>
          <QU>m</QU>
          <Description ID="R20240107150352588000001">
           <StLNo Type="StLK">18115921111201</StLNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Böschungstreppe nach Unterlagen des AG entsprechend RiZ</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bösch auf mindestens 10 cm dickem, konstruktiv bewehr-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">tem Unterbeton C12/15,  Ausbreitmaßklasse F1 einschlie-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">ßlich ggf. notwendiger Sporne zur Gleitsicherung</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">einschließlich der erforderlichen Erdarbeiten herstel-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">len. Abgerechnet wird die Treppenlänge in der Neigung</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">von der Vorderkante der untersten bis Vorderkante der</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">obersten Stufe einschließlich der Stufen an den Podes-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">ten.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Stufenbreite 80 cm.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Auftrittshöhe 18 cm, Auftrittsbreite 27 cm.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Blockstufen aus Betonfertigteilen, Druckfestigkeits-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">klasse C35/45, Expositionsklasse XC4, XD1, XF2.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Beidseitige Treppenwange auf Böschungen aus Betonbord-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">steinen, Form TB 80 x 250, auf gleichem Fundament wie</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Böschungstreppe herstellen. Den Fundamentbeton als</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Rückenstütze mit einer Breite von 15 cm bis 10 cm unter</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Steinoberkante hochziehen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Fugen mit Fertigzementmörtel verfüllen, Druckfestigkeit</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">am Würfel mind. 50 N/mm2, Zement Art CEM I, w/z höchs-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">tens 0,50, frost-/tausalzbeständig, Ausbreitmaßklasse</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">F3.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Böschungstreppe herstellen.</span>
                <br/>
                <span>Stufenbr. 80 cm*H/B 18/27 cm</span>
                <br/>
                <span>Betonfertigteile*beids. Tr.w. Bet.</span>
                <br/>
                <span>Fugenmörtel</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
     </BoQBody>
    </BoQCtgy>
    <BoQCtgy ID="AAAAAAABIECJAAAA" RNoPart="3">
     <LblTx>
      <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
       <span>Böschungsbewässerung</span>
      </p>
     </LblTx>
     <BoQBody>
      <BoQCtgy ID="AAAAAAABIECJBAAA" RNoPart="1">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Erd- und Verbauarbeiten</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Remark ID="AAAAAAABIECJBJDI">
          <Description ID="R20240301130424195000073">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-weight:bold;font-size:10pt;Color:rgb(0,0,0);">Vorbemerkungen Erdarbeiten</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die nachfolgenden Positionen der Erdarbeiten umfassen nur solche Erdarbeiten, die außerhalb von Baugruben anderer Abschnitte dieses Leistungsverzeichnisses erforderlich werden.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Für die Aushubarbeiten gilt hierbei, dass die fachgerechte Entsorgung des Aushubs nicht Gegenstand  der nachfolgenden Positionen ist. Die fachgerechte Entsorgung wird über entsprechende Positionen des Abschnitts 2 vergütet.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Mit Erschwernissen und Behinderungen durch Versorgungs- und Entsorgungsleitungen ist im innerstädtischen Bereich grundsätzlich zu rechnen. Ein entsprechend vorsichtiges Arbeiten ist daher in die Preise einzukalkulieren. Eine zusätzliche Vergütung hierfür erfolgt nicht.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Soweit darüber hinaus örtliche Erschwernisse eintreten, die zusätzliche Vergütungen rechtfertigen, sind diese mittels aussagekräftigem, fotografischen Nachweis zu dokumentieren.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Hierzu wird auf §4 (10) der VOB/B verwiesen.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zulagepositionen  für die Beseitigung von auftretenden Hindernissen sind in den nachfolgenden Positionen der Erdarbeiten enthalten.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Vorbemerkungen Erdarbeiten</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Remark>
         <Item ID="AAAAAAABIECJCCOI" RNoPart="10">
          <Qty>110.000</Qty>
          <QU>m3</QU>
          <Description ID="R20240301130424590000074">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Auffüllboden für verbaute Gräben und Baugruben lösen, laden</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Auffüllboden profilgerecht lösen, laden, und im Baustellenbereich transportieren.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Lösen auch in Klein- und Teilflächen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">auch mit mineralischen Fremdbestandteilen &#x3c; 10 Vol %</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Parameter des Homogenbereichs B gem. geotechnischem Bericht / Vorbemerkungen zum Leistungsverzeichnis.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abrechnung erfolgt nach Abtragsprofilen durch Aufmaß an der Entnahmestelle.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Auffüllboden im verbauten Graben lösen, laden</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIECJDODI" RNoPart="20">
          <Qty>170.000</Qty>
          <QU>m3</QU>
          <Description ID="R20240301130424598000075">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Auffüllboden für unverbaute Gräben und Baugruben lösen, laden</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Auffüllboden profilgerecht lösen, laden, und im Baustellenbereich transportieren.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Lösen auch in Klein- und Teilflächen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">auch mit mineralischen Fremdbestandteilen &#x3c; 10 Vol %</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Parameter des Homogenbereichs B gem. geotechnischem Bericht / Vorbemerkungen zum Leistungsverzeichnis.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einzurechnen sind alle Erschwernisse, die sich für die Leistungserbringung auf den Böschungsflächen unter dem Brückenbauwerk ergeben.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Böschungsneigung bis 40 Grad, Böschungslängen bis 8 m</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abrechnung erfolgt nach Abtragsprofilen durch Aufmaß an der Entnahmestelle.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Auffüllboden im unverbauten Graben lösen, laden</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIECJFKBI" RNoPart="30">
          <Qty>5.000</Qty>
          <QU>m3</QU>
          <Description ID="R20240301130424605000076">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-weight:bold;font-size:10pt;Color:rgb(0,0,0);">Auffüllboden in Handschachtung lösen, laden als Zulage zum Bodenaushub</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Auffüllboden an kleineren Stellen, wo kein maschineller Einsatz möglich ist, in Handschachtung profilgerecht lösen und dem Aushubgerät zuschaufeln als Zulage zum Bodenaushub.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abrechnung erfolgt nach Abtragsprofilen durch Aufmaß an der Entnahmestelle.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Auffüllboden in Handschachtung lösen, laden als Zulage zum Bodenaushub</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIECJHFCA" RNoPart="40">
          <Qty>2.000</Qty>
          <QU>m3</QU>
          <Description ID="R20240301130424610000077">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Beton, unbewehrten, in der Baugrube vorgefunden,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">abbrechen und abfahren, als Zulage zum Bodenaushub.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abrechnung erfolgt durch Aufmaß an der Entnahmestelle.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Unbewehrten Beton abbrechen, laden als Zulage zum Bodenaushub</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIECJIPMI" RNoPart="50">
          <Qty>2.000</Qty>
          <QU>m3</QU>
          <Description ID="R20240301130424619000078">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Mauerwerk, in der Baugrube vorgefunden, aus Ziegel-</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">oder Bruchstein abbrechen und abfahren, als Zulage zum Bodenaushub.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abrechnung erfolgt nach Abtragsprofilen durch Aufmaß an der Entnahmestelle.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Mauerwerk abbrechen, laden als Zulage zum Bodenaushub</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Remark ID="AAAAAAABIECJKKNI">
          <Description ID="R20240301130424623000079">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-weight:bold;font-size:10pt;Color:rgb(0,0,0);">Vorbemerkungen</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Leitungen und Kabel vorsichtig durch Handschachtung gemäß Kabelschutzanweisung aufsuchen, Kabelschutz aus unterschiedlichem Material aufnehmen und zwischenlagern, Leitung ringsum freilegen, aufhängen, abstützen oder</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">umlegen, für die Dauer der Bauarbeiten, auch in Einzelabschnitten.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Wenn mit Abweichungen der Leitungen von der bezeichneten Leitungstrasse gerechnet werden muss, gelten die gleichen Vorsichtsmaßnahmen auch neben der vermuteten Leitungstrasse.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Mit Abschluss der Arbeiten sind die Versorgungsleitungen wieder fachgerecht im Leitungsgraben zu verlegen, abzusanden (Kabelsand 0/2 bis 0/4) und mit Kabelschutz und Trassenwarnbändern abzudecken.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Eventuell erforderliche Einmessarbeiten sind vom AN rechtzeitig beim VU anzuzeigen.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Versorgungsleitungen:</span>
              </p>
              <ul style="font-family:Symbol;font-size:10pt;Color:rgb(0,0,0);">
               <li>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabel und Rohre aus verschiedenen Materialien</span>
               </li>
               <li>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">unter Druck stehend</span>
               </li>
               <li>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">unter Spannung stehend</span>
               </li>
               <li>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Durchmesser bis 200 mm</span>
               </li>
               <li>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Aushubtiefe bis 1,00 m unter Gradientenhöhe der Verkehrsfläche</span>
               </li>
               <li>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Querende Leitungen bis zu einer Länge von  5,00 m</span>
               </li>
              </ul>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Es sind alle vorstehenden Arbeiten und sonstige Erschwernisse bei den Erd- und Verbauarbeiten, z.B. Handschachtung und Sicherungsmaßnahmen, in die Einheitspreise einzurechnen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Vorbemerkungen Versorgungsleitungen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Remark>
         <Item ID="AAAAAAABIECJLLKA" RNoPart="60">
          <Qty>10.000</Qty>
          <QU>m</QU>
          <Description ID="R20240301130424665000080">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Freilegen und Sichern von Versorgungsleitungen, Handschachtung, quer</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Freilegen und Sichern der beim Straßenaufbruch bzw. Bodenaushub vorgefundenen, kreuzenden oder schräg zur Baugrube/Graben verlaufenden Versorgungsleitungen durch Handschachtung (Gas-, Strom-, Wasser-, Fernmelde-, Fernwärmeleitungen etc.).</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vor Beginn der Arbeiten hat sich der AN bei den Versorgungsunternehmen (VU) über die Lage der Leitungen und der Sicherheitsvorkehrungen zu erkundigen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Mehrere nebeneinander liegende Versorgungsleitungen, auch unterschiedlicher Transportmedien, bis 3 Stück innerhalb eines Streifens von 0,50 m lichter Breite, sowie gebündelte Leitungen oder mehrere Leitungen in Formsteinen werden als eine Leitung abgerechnet.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Für die Abrechnung der Leistungen gilt die Voraussetzung, dass die Leitungskreuzungen nach Lage und Anzahl, sowie mit Angabe der Art der Leitungen und Kabel und Bezeichnungen des jeweiligen VU in Aufmaßskizzen und Fotos nachzuweisen sind.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Diese Nachweise sind der Bauleitung umgehend zur Anerkennung vorzulegen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die Bauleitung behält sich vor, eine Bestätigung der Erfordernisse der Leistung seitens des zuständigen VU zu verlangen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Der AN haftet auch nach Verfüllung und Verdichtung für einen ordnungsgemäßen Zustand, auch dann, wenn Schäden erst nach Beendigung der Arbeiten auftreten.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Freilegen und Sichern von Versorgungsleitungen, Handschachtung, quer</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIECJNJFA" RNoPart="70">
          <Qty>30.000</Qty>
          <QU>m</QU>
          <Description ID="R20240301130424672000081">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Freilegen und Sichern von Versorgungsleitungen, Handschachtung, längs</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Freilegen und Sichern der beim Straßenaufbruch bzw. Bodenaushub vorgefundenen Versorgungsleitungen durch Handschachtung (Gas-, Strom-,  Wasser-, Fernmelde-, Fernwärmeleitungen etc.).</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vor Beginn der Arbeiten hat sich der AN bei den Versorgungsunternehmen (VU) über die Lage der Leitungen und der Sicherheitsvorkehrungen zu erkundigen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Mehrere nebeneinander liegende Versorgungsleitungen, auch unterschiedlicher Transportmedien, bis 3 Stück innerhalb eines Streifens von 0,50 m lichter</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Breite, sowie gebündelte Leitungen oder mehrere Leitungen in Formsteinen werden als eine Leitung abgerechnet.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Für die Abrechnung der Leistungen gilt die Voraussetzung, dass die Leitungen nach Lage und Anzahl, sowie mit Angabe der Art der Leitungen und Kabel und Bezeichnungen des jeweiligen VU in Aufmaßskizzen und Fotos nachzuweisen sind.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Diese Nachweise sind der Bauleitung umgehend zur Anerkennung vorzulegen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die Bauleitung behält sich vor, eine Bestätigung der Erfordernisse der Leistung seitens des zuständigen VU zu verlangen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Der AN haftet auch nach Verfüllung und Verdichtung für einen ordnungsgemäßen Zustand, auch dann, wenn Schäden erst nach Beendigung der Arbeiten auftreten.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Freilegen und Sichern von Versorgungsleitungen, Handschachtung, längs</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Remark ID="AAAAAAABIECJPGII">
          <Description ID="R20240301130424676000082">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vorbemerkungen Verbauarbeiten</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Verbau nur mit berufsgenossenschaftlich anerkannten Verbaugeräten entsprechend den dazugehörigen Betriebsanleitungen ausführen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">(Betriebsanleitung auf der Baustelle ständig zur Verfügung halten).</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">In den Einheitspreis einrechnen:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- Grabenwände geschlossen verbauen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- Verbau und erforderl. Aussteifungen stellen, vorhalten,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">  später wieder entfernen, einschl. der erforderl. Änderung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">  der Aussteifungen für Rohrverlegung bzw.Bauwerke.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- Sichern und Aussparen auftretender Hindernisse.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">  (Kabel, Rohr, Leitungen u.ä.)</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- Kosten für Statik, Prüfstatik. Statischer Nachweis:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">  Sofern nicht ein Normverbau nach DIN 4124 zur</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">  Ausführung kommt hat der&#x22;AN&#x22; unaufgefordert vor Beginn</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">  der Ausschachtungsarbeiten einen statischen Nachweis in</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">  2-facher Ausführung zu erbringen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Mehraushub:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kosten für Mehraushub aufgrund größerer Verbaubreiten</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">gegen- über den DIN-Breiten ( DIN EN 1610) einschl. der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">erforderl. Mehrverfüllung in den EP einrechnen.</span>
               <br/>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Vorbemerkungen Verbauarbeiten</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Remark>
         <Item ID="AAAAAAABIECLAIGI" RNoPart="80">
          <Qty>150.000</Qty>
          <QU>m2</QU>
          <Description ID="R20240301130424718000083">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baugruben- und Grabenverbau aus: Dielenkammerelementen, einschl. der erforderlichen Umsteifungsarbeiten.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Das Eindrücken der Dielen erfolgt parallel zum Aushub durch Bagger oder ähnlichem Gerät.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Baugruben- und Grabenverbau aus</span>
                <br/>
                <span>Dielenkammerelementen.</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
      <BoQCtgy ID="AAAAAAABIECLCLMI" RNoPart="2">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Rohrverlegearbeiten</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Remark ID="AAAAAAABIECLDFAA">
          <Description ID="R20240301130425006000085">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vorbemerkungen Bettung für Leitungen</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bettung (Rohrauflager) nach DIN EN 1610, DWA- A 139 für Steinzeug-, Beton-, Stahlbeton- und Kunststoff-Rohre gemäß den Verlegevorschriften des Lieferwerkes</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- nach Zeichnung bzw. Angabe der Bauleitung -</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">höhen- und fluchtgerecht einschl. aller Nebenarbeiten herstellen.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">-  Bettung Typ 1 auf voller Grabenbreite</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">-  untere Bettungsschicht Dicke bei Sand-Kies-Gemisch</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">   100 mm</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">-  untere Bettungsschicht Dicke bei Sand-Kies-Gemisch</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">   auf Fels sehr dicht gelagerten Böden 150 mm</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">-  untere Bettungsschicht Dicke bei Betonauflager</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">   50 mm + 1/10 DN,  min. 100 mm</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">   in C 12/15,  X0  aus Traßzement  MV =  30:70</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Rohre ohne Fuß</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- obere Bettungsschicht bei Auflagerwinkel von 90°:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">  Dicke = 0,15 OD</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- obere Bettungsschicht bei Auflagerwinkel von 120°:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">  Dicke = 0,25 OD</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die Abrechnung erfolgt nach m3</span>
               <br/>
               <br/>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Vorbemerkungen Bettung für Leitungen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Remark>
         <Item ID="AAAAAAABIECLEFHI" RNoPart="10">
          <Qty>85.000</Qty>
          <QU>m</QU>
          <Description ID="R20240301130425009000086">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">KG-Anschlussleitung DN 110 liefern und verlegen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vollwandrohrsystem KG-2000 nach DIN EN 14758-1 aus Polypropylen (PP) in DN 110 (OD), mineralverstärkt, einschließlich der erforderlichen Dichtungen, aller Form- und Passstücke soweit diese nicht in eigenen Positionen enthalten sind.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Farbe: Maigrün RAL 6017</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einschließlich der natürlichen Baustoffe für die Leitungszone (nach DIN EN 1610) liefern und innerhalb der Leitungszone verlegen und absanden.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Natürliche Baustoffe für die Leitungszone:</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Sande (SE,SW,SI), stark sandige Kiese, sandige Kiese mit</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Sandanteil &#x3e;15% und Ungleichförmigkeitszahl Cu &#x3e; 3,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Größtkorn &#x3c;/= 8 mm</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Dicke der unteren Bettungszone &#x3e;/= 100 mm</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bodeneinbau bis 30 cm über Rohrscheitel (OK Leitungszone)</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Verdichtung der Leitungszone mit leichtem Verdichtungsgerät</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einzurechnen sind alle Erschwernisse, die sich für die Leistungserbringung auf den Böschungsflächen unter dem Brückenbauwerk ergeben.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Böschungsneigung bis 40 Grad, Böschungslängen bis 8 m</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>KG-Anschlussleitung DN 110 liefern und verlegen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>

            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Handlauf einbauen, Holz, mit Aufnahme für Beleuchtung</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>

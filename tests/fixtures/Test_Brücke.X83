    <BoQCtgy ID="AAAAAAABIEDFAAAA" RNoPart="7">
     <LblTx>
      <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
       <span>Vegetations- und Pflanzarbeiten, Pflegearbeiten</span>
      </p>
     </LblTx>
     <BoQBody>
      <BoQCtgy ID="AAAAAAABIEDFBAAA" RNoPart="1">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Vegetationsarbeiten</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Item ID="AAAAAAABIEDFBJDI" RNoPart="10">
          <Qty>650.000</Qty>
          <QU>m2</QU>
          <Description ID="R20240712144218207000071">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Untergrund / Unterbau vor Auftrag der Vegetations-</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">tragschicht lockern für eine gute Verzahnung mit dem </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Oberbodengemisch.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ausführung: von Hand</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bearbeitungstiefe: ca. 5-10 cm</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">besondere Hinweise: Steine ab 5 cm Durchmesser,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Fremdkörper und schwer verrottbare Pflanzenteile vor</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ausführung ablesen und gemäß Kreislaufwirtschaftsgesetz</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">entsorgen, die Kosten sind einzukalkulieren.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einbauort: gemäß Lageplan</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abrechnung: nach Flächenaufmaß</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Untergrund / Unterbau vor Auftrag der Vegetations-</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEDFCOMI" RNoPart="20">
          <Qty>165.000</Qty>
          <QU>m3</QU>
          <Description ID="R20240712144218208000072">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Oberbodengemisch liefern, einbauen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Humosen, schwach bindigen Oberboden liefern</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">nach DIN 18915 - </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">mit 15 % groben Sand ohne Lehmanteil (0/8) und </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">15% Lava 8/16 mischen und</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">profilgerecht auftragen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Homogenbereich 0</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Der Oberboden muss den Werten oder Vorsorgewerten der</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bundesbodenschutzverordnung (BBodSchV) entsprechen!</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Nachweisführung über Eignung, Beschaffenheit und</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Herkunftmuss vor Lieferung / Einbau erfolgen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die Mengenangabe im LV bezieht sich nur auf den</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">rechnerischen Wert der Auffüllmenge. Die durch die</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">natürliche Verdichtung notwendigen Mehrmassen sind im EP</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einzurechnen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Das Material wird von der BL zum Einbau freigegeben, gggfs sind </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Liefernachweise vorzulegen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einbaustärke ca. 25 cm</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zuordnung LAGA: Z0</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Geländeneigung: 1:1,5</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Oberbodengemisch liefern und einbauen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEDFELJA" RNoPart="30">
          <Qty>650.000</Qty>
          <QU>m2</QU>
          <Description ID="R20240712144218210000073">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Feinplanum für Staudenflächen herstellen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Gilt für Homogenitätsbereich &#x22;A&#x22; und gelieferten</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Oberboden.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abweichungen von der Sollhöhe: +/- 3 cm unter 4 m Latte</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Böschungen / Hangneigung: bis 1:2</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ausführung: Anschlüsse an Wege, Plätze und sonstige</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Beläge 2 cm tiefer ausführen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Unrat und Steine mit einem Durchmesser &#x3e; 5 cm und</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">schwer verrottbare Pflanzenteile sind abzulesen und</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">gemäß Kreislaufwirtschaftsgesetz zu entsorgen, die</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kosten sind einzukalkulieren.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Feinplanum für Staudenflächen herstellen.</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEDFGHFI" RNoPart="40">
          <Qty>650.000</Qty>
          <QU>m2</QU>
          <Description ID="R20240712144218211000074">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Krallgewebe/Erosionsschutzmatte liefern und verlegen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">zur Sicherung der Böschung.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Material: Jute (ohne Kunsstoff)</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Flächengewicht: 400-500 g g</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Breite:1,20-2,00 m überlappend verlegen - 10-15 cm cm</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Maschenweite: ca. 25 x 25 mm</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Befestigung mit Erdankern aus Buchenholz o.ä./ mind. 3 St je m²</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Den vorgegebenen Anforderungen entspricht z.B.:</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Fabrikat: greentex Jutegewebe - www.glaeser-green.de</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;text-decoration:underline;font-size:10pt;Color:rgb(0,0,0);">angebotenes Fabrikat/Typ des Bieters:</span>
              </p>
              <p style="margin-left:1pt;text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="margin-left:1pt;text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="margin-left:1pt;text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Name: Greentex</span>
              </p>
              <p style="margin-left:1pt;text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="margin-left:1pt;text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="margin-left:1pt;text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bei Nichtausfüllung des angebotenen Fabrikates gilt die Angabe des</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Leitproduktes als vertraglicher Bestandteil.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Krallgewebe aus Jute liefern und verlegen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Remark ID="AAAAAAABIEDFIDLI">
          <Description ID="R20240712144218214000076">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Stauden sortenrein liefern </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- die Pflanzen müssen den Gütebestimmungen für Stauden</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> der FLL entsprechen </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und pflanzen nach DIN 18916</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Das Öffnen der Krallmatte aus Jute zur Pflanzung der Stauden ist einzukalkulieren.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Nach Pflanzung sind die Stauden durchdringend an zu wässern.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Pflanzhinweise Stauden</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Remark>

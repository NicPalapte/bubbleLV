         <Item ID="AAAAAAABIEFGAGHA" RNoPart="80">
          <Qty>8.000</Qty>
          <QU>St</QU>
          <Description ID="R20240301130425059000093">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Auslaufstück DN/OD 110, mit Froschklappe, muffenlos</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einschließlich Bogen 90 Grad  mit zwei angeformten Muffen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Farbe (RAL): 5015 blau</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baulänge: 500 mm</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">zur Verwnedung als Lüftungsöffnung für Speicherrigolen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Froschklappe als Luftdurchlässiger Gitterdeckel.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-weight:bold;font-size:10pt;Color:rgb(0,0,0);">Technische Eigenschaften:</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Material: Polyvinylchlorid (PVC-U), weichmacherfrei</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vollwandrohr mit Innenbeschriftung</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">SDR-Klasse: 34</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bogen mit Auslaufstück an Lüftungsanschluss der Speicherrigolen anschließen einschließlich ggf. erforderlichem Einkürzen des Anschlussstücks zwecks Anpassung an den Böschungsverlauf.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Lüftungsleitung DN/OD 110 PVC, mit Froschklappe</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
      <BoQCtgy ID="AAAAAAABIEFGCJJI" RNoPart="3">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Schächte und Sonderbauteile</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Remark ID="AAAAAAABIEFGDCNA">
          <Description ID="R20240301130425065000095">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vorbemerkungen</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schächte aus Beton- und Stahlbetonfertigteilen nach</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">DIN EN 1917 und DIN V 4034-1 Typ 2</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die nachfolgend beschriebenen Positionen gelten für wasserdichte Schachtunterteile und Schachtfertigteile für Schächte mit gerader und abgewinkelter durchlaufender Rohrachse.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abwicklungen bis 5 Grad können bei Schächten mit geradem Durchlauf in der Muffe ausgebildet werden.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Der genaue Winkel für Schächte mit abgewinkeltem Durchlauf ist in der Örtlichkeit zu messen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Der lichte Mindestdurchmesser für Schachtunterteile beträgt 1000 mm. </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Auftrittsflächen auf dem Bankett sind mind. 25 cm breit herzustellen.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">In die Positionen der Schachtfertihgteile ist die werkseitig gelieferte Dichtung für Fertigteile nach DIN 4060, DIN EN 681-1 einzukalkulieren</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Statischer Nachweis:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die statisch erforderl. Abmessungen und Bewehrungen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">müssen den Einbaubedingungen entsprechen.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schachtwände:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">In die Schachtwände Öffnungen für den Anschluss der ankommenden bzw. abgehenden Rohre einschl. Dichtung vorsehen.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Rohranschlüsse:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die Schachtunterteile können mit angeformter Muffe oder eingebauten Anschlussstücken ausgebildet sein. Der Anschluss der Rohre erfolgt scheitelgleich.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die sich aus den unterschiedlichen Durchmessern ergebenden Höhendifferenzen in der Schachtsohle ausgleichen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bei Schachtunterteilen mit eingebauten Anschlussstücken sind diese mit entsprechender Neigung der zu- und ablaufender Leitung einzubauen.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Art des Rohranschlusses:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">In den Schachtunterteilen können die ankommenden Rohre mit Steckmuffe, Gleitringdichtung oder mit werkseitig eingebauter Dichtung nach DIN 4060, DIN EN 681-1 je nach Rohrart ausgebildet sein.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">In Sonderfällen können Rohre auch bis in den Schacht (mit innenseitigem Überstand) geführt werden. Dies wird in der jeweiligen Schachtposition besonders kenntlich gemacht.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schachtsohlen:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die Sohlen und Bankette der Schächte sind aus Kanalklinkerriemchen mit den Mindestabmessungen 240/50/50 mm und den Qualitätsmerkmalen nach DIN 4051 herzustellen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bei Rohren bis DN 600 mm die seitlichen Bankette bis Rohrscheitel, bei Rohren mit DN größer 600 mm die Bankette bis zur Kämpferhöhe, jedoch mindestens 600 mm</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">hoch herstellen.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Soweit in der jeweiligen Position des Schachtunterteils nichts anderes beschrieben steht, ist die werkseitige Herstellung sämtlicher Schachtsohlen und Bankette einschließlich Ausmuldungen an den Rohranschlüssen in den Einheitspreis des Schachtunterteiles einrechnen.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Steigbügel mit seitlicher Aufkantung Form B nach DIN 19555 und EN 1301 der Klasse 1, Edelstahl, Ummnatelung aus Polypropylen ( PP). Form B,SST, orange, Steigmass 250 mm einbauen</span>
               <br/>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einbau:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Fertigteile an der Verwendungsstelle abladen, höhen- und fluchtgerecht, sowie wasserdicht unter Beachtung der Verlegehinweise des Herstellers und nach Angabe des &#x22;AG&#x22; einbauen.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abrechnung:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Für Schachtunterteile mit mittigem Rohrdurchgang erfolgt die Abrechnung nach Stück, wobei der lichte Durchmesser des Unterteiles von der Rohrlänge abgezogen wird.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Vorbemerkungen Schächte aus Beton- und Stahlbetonfertigteilen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Remark>
         <Item ID="AAAAAAABIEFGEHMI" RNoPart="10">
          <Qty>20.000</Qty>
          <QU>m2</QU>
          <Description ID="R20240301130425067000096">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Beton der Sauberkeitsschicht einbauen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Festigkeitsklasse:     C :12/15.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Expositonsklasse         :X0.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">besondere Eigenschaften  :./..</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Stärke Sauberkeitsschicht:10 cm.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abgerechnet wird die Grundfläche des auf der Sauberkeitsschicht gegründeten Bauwerks zzgl. allseitigem Überstand von 10 cm.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Beton der Sauberkeitsschicht</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEFGGCKI" RNoPart="20">
          <Qty>2.000</Qty>
          <QU>St</QU>
          <Description ID="R20240301130425070000097">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schachtunterteil  (SU-M Typ 2)  aus  Beton für geraden mittigen Durchlauf als Rohling ohne Bankette und Gerinne versetzen,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">lichte Bauteilhöhe ca. 1,0 m</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vorbereitet für Rohranschlüsse mit Höhenversatz</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anschluss Zulauf DN: 200 mm,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zulauf mit eingebautem Anschlussstück für</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Rohre aus PP oder PVC</span>
               <br/>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anschluss Ablauf 1 DN: 200 mm,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ablauf 1 mit eingebautem Anschlussstück für</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Rohre aus PP oder PVC</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anschluss Ablauf 2 mit KG-Schachtfutter DN 200 zur wasserdichten Schachtdurchführung von Rohren aus PP oder PVC.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Nachträglicher Einbau der Sohl- und Bankettflächen erfolgt nach Instatallation der Einbauteile und wird über gesonderte Position vergütet.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bauteil: Schieberschacht</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schachtunterteil (SU-M Typ 2) aus Beton</span>
                <br/>
                <span>nach DIN EN 1917 und DIN V 4034-1 Typ 2</span>
                <br/>
                <span>für abgewinkelten, mittigen Durchlauf, herstellen</span>
                <br/>
                <span>als Rohling</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEFGHPCA" RNoPart="30">
          <Qty>2.000</Qty>
          <QU>St</QU>
          <Description ID="R20240301130425108000098">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schachtunterteil  (SU-M Typ 2)  aus  Beton für geraden mittigen Durchlauf als Rohling ohne Bankette und Gerinne versetzen,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">lichte Bauteilhöhe ca. 0,9 m</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anschluss Zulauf DN: 200 mm,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zulauf mit eingebautem Anschlussstück für</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Rohre aus PP oder PVC</span>
               <br/>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anschlüsse Ablauf 1 und 2 mit KG-Schachtfutter DN 200 zur wasserdichten Schachtdurchführung von Rohren aus PP oder PVC.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Nachträglicher Einbau der Sohl- und Bankettflächen erfolgt nach Instatallation der Einbauteile und wird über gesonderte Position vergütet.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bauteil: Verteilerschacht</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schachtunterteil (SU-M Typ 2) aus Beton</span>
                <br/>
                <span>nach DIN EN 1917 und DIN V 4034-1 Typ 2</span>
                <br/>
                <span>für geraden, mittigen Durchlauf, herstellen</span>
                <br/>
                <span>Anschluss Zulauf DN: 300 als Rohling</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEFGJLHA" RNoPart="40">
          <Qty>4.000</Qty>
          <QU>m2</QU>
          <Description ID="R20240301130425110000099">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Sohlgerinne und Bankette sowie alle Mulden für Leitungen in die Schachtbauwerke aus Wasserbauklinker oder Formsteinen nach DIN 4051 in Mörtel nach DIN 1053 MG III nach Angabe des AG herstellen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Es ist ein kunststoffmodifizierter Zementmörtel nach den Qualitätsmerkmalen der DAfStb Instandsetzungsrichtlinie der Beanspruchbarkeitsklasse M3 zu verwenden.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Das zur Verwendung kommende Material und die Art und Form des jeweiligen Einbaues dem &#x22;AG&#x22; vor Arbeitsaufnahme vorlegen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- Bei Rohren bis DN 600 mm die seitliche Bankette bis</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">  Rohrscheitel,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">In den Einheitspreis einrechnen:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- Erforderlichen Auffüllbeton hertellen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">  Betongüte bei Flächen, die später verklinkert werden</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">  C8/10,X0 Betongüte bei unverkleideten Flächen C35/45,XA2</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- Erforderl. Abstürze bis 30 cm Höhendifferenz,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- Auskratzen und Verfugen der Steine und Formsteine,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- Säuberung der Schachtsohle,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- Abfuhr und Entsorgung des anfallenden Schuttes</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- evtl. erforderl. Wasserhaltung.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Aufgemessen wird die Fläche in horizontaler Projektion.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abgerechnet werden:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">   Schachtsohlen nach m2</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schachtsohlen auskleiden.</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEFGLIJI" RNoPart="50">
          <Qty>2.000</Qty>
          <QU>St</QU>
          <Description ID="R20240301130425113000100">
           <CompleteText>
            <DetailTxt>
             <Text>

      <BoQCtgy ID="AAAAAAABIEGCPAMI" RNoPart="21">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Erdplanum / Schotterplanum</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Item ID="AAAAAAABIEGHAAAA" RNoPart="10">
          <Qty>1005.000</Qty>
          <QU>m2</QU>
          <Description ID="R20240103193121732000439">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Erdplanum in Verkehrsflächen herstellen und verdichten</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Erdplanum in Fahrbahnflächen herstellen und maschinell verdichten.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">

         <Item ID="AAAAAAABIEANNIEA" RNoPart="230">
          <Qty>3.000</Qty>
          <QU>St</QU>
          <Description ID="R20240414113251549000008">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Entnahme von Mischproben aus Abbruchgut und Durchführung von Deklarationsanalysen gem. LAGA (Abfall) </span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">

         <Item ID="AAAAAAABIECINAJI" RNoPart="100">
          <Qty>5.000</Qty>
          <QU>St</QU>
          <Description ID="R20230831173957194000004">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Rohrdurchführung mit Mantelrohr nach Unterlagen des AG</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">herstellen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einbauort = Kammerwand.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Mantelrohr DN 80 </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Mantelrohr aus Faserzement.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Außendurchmesser Medienrohr 32 mm </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Rohrdurchführung mit Dichtungseinsatz aus Elastomer und</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">nichtrostendem Stahl Werkstoffnummer 1.4401 bzw.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">1.4571.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Dichtend gegen nichtdrückendes Wasser.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Rohrdurchführung herstellen,Kammerwand, Mantelrohr DN 80,</span>
                <br/>
                <span>Faserzement, Medienrohr DN 32</span>
                <br/>
                <span>Nichtrost. Stahl*nichtdr. Wasser</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIECINIPA" RNoPart="110">
          <Qty>6.000</Qty>
          <QU>St</QU>
          <Description ID="R20230831174115241000005">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Rohrdurchführung mit Mantelrohr nach Unterlagen des AG</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">herstellen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einbauort = Kammerwand.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Mantelrohr = DN 200</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Mantelrohr aus Faserzement.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Außendurchmesser Medienrohr = 150 mm</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Rohrdurchführung mit Dichtungseinsatz aus Elastomer und</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">nichtrostendem Stahl Werkstoffnummer 1.4401 bzw.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">1.4571.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Dichtend gegen nichtdrückendes Wasser.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Rohrdurchführung herstellen</span>
                <br/>
                <span>Kammerwand. Mantelrohr DN 200,</span>
                <br/>
                <span>Faserzement, Medienrohr DN 150</span>
                <br/>
                <span>Nichtrost. Stahl*nichtdr. Wasser</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIECIOBEI" RNoPart="120">
          <Qty>12.000</Qty>
          <QU>St</QU>
          <Description ID="R20230831173320612000002">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Rohrdurchführung mit Mantelrohr nach Unterlagen des AG</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">herstellen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einbauort = Kammerwand.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Mantelrohr DN 150 </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Mantelrohr aus Faserzement </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Außendurchmesser Medienrohr = 110 mm </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Rohrdurchführung mit Dichtungseinsatz aus Elastomer und</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">nichtrostendem Stahl Werkstoffnummer 1.4401 bzw.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">1.4571.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Dichtend gegen nichtdrückendes Wasser.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Rohrdurchführung herstellen</span>
                <br/>
                <span>Kammerwand, Mantelrohr DN 150</span>
                <br/>
                <span>Faserzement, Medienrohr DN 110, Nichtrost. Stahl*nichtdr. Wasser</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIECIOJKA" RNoPart="130">
          <Qty>8.000</Qty>
          <QU>St</QU>
          <Description ID="R20230904185944124000005">
           <StLNo Type="StLK">1512197122231103</StLNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Messbolzen einbauen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einbauort = Widerlager.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Material = Messing.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Schaftdurchmesser über 20 bis 30 mm.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Schaftlänge über 80 bis 120 mm.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einbau horizontal.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bolzen in Bohrungen einsetzen. Bohrungen herstellen und</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">mit Mörtel verfüllen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Messbolzen für Lage- und Höhenmessung.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Messbolzen einbauen</span>
                <br/>
                <span>Widerlager*Messing</span>
                <br/>
                <span>DU 20 - 30 mm*L 80 -120 mm</span>
                <br/>
                <span>Horizontal*Mörtel*Lage-/Höhenmessg</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIECIPBPI" RNoPart="140">
          <Qty>3.300</Qty>
          <QU>m</QU>
          <Description ID="R20230831190620189000015">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Rohrleitung aus nichtrostendem Stahl, Werkstoff-Nr.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">1.4571, längsgeschweißt, für Brückenentwässerung aus</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">muffenlosen Rohren und Formstücken einschließlich Rei-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">nigungsöffnungen, Verankerungen, Aufhängungen, Ausstei-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">fungen, Unterstützungen und Anschlüssen entsprechend</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">statischen und konstruktiven Erfordernissen nach Unter-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">lagen des AG herstellen. Abgerechnet wird nach Länge in</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">der Achse der Rohrleitung.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einbauort = Widerlager.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Rohr DN/ID 100</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Wanddicke = 2 mm.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Oberfläche beschichten nach Unterlagen des AG.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Verankerung Einbau in die Betonwand des Widerlagers</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">zur Entwässerung der Lagerbank gemäß Was 6 Blatt</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Rohrl. aus nichtrost. Stahl herst.</span>
                <br/>
                <span>Widerlager, Rohr DN 100</span>
                <br/>
                <span>Wanddicke 2 m1m*beschichten</span>
                <br/>
                <span>Einbau in Betonwand Widerlager gemäß WAS 6</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEDIAAAA" RNoPart="150">
          <Qty>2.000</Qty>
          <QU>St</QU>
          <Description ID="R20210623173928881000057">
           <StLNo Type="StLK">1611892300</StLNo>
           <CompleteText>

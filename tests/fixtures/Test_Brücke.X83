           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEGHBGJI" RNoPart="20">
          <Qty>582.000</Qty>
          <QU>m2</QU>
          <Description ID="R20240103193121737000440">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Erdplanum in Nebenflächen herstellen und verdichten</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Erdplanum in Nebenflächen wie Gehweg-, Radweg-, Garagenhofflächen herstellen und maschinell verdichten.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Toleranz für Sollhöhe +/- 2 cm</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Verformungsmodul Ev2 = min. 45 MPa</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">

            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Mehrzweck-Verbindungsklemme Fl 3,5 x 30, NIRO (V4A)</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Verbindungs-, Kreuzklemme</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">für ober- und unterirdische Verbindungen zum Verbinden von Leitern, als Verlängerung, in Kreuz- oder T-Anordnung</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Blitzstromtragfähig geprüft nach EN 50164-1 mit</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Sechskantschraube und Gewinde im Unterteil, gemäß DIN</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">EN 50164-1, Material NIRO V4A (Werkstoff-Nr. 1.4571),</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Verbindungs-, Kreuzklemme</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">für ober- und unterirdische Verbindungen zum Verbinden von Leitern, als Verlängerung, in Kreuz- oder T-Anordnung</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Werkstoff Klemme: </span>
               <span style="font-family:Arial;font-weight:bold;font-size:10pt;Color:rgb(0,0,0);">NIRO (V4A)</span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Klemmbereich Fl / Fl: 30 / 30 mm</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Werkstoff-Nr.: 1.4571 / 1.4404 / 1.4401 </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ASTM / AISI:: 316Ti / 316L / 316 </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Normenbezug: DIN EN 62561-1 </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Klemmbereich Fl 3,5 x 3 mit Bewehrung und Flachband inkl. Schrauben</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Liefern und montieren.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Mehrzweck- Schrauben Verbindungsklemme Fl 3,5 x 30, NIRO (V4A)</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEFKFBKI" RNoPart="130">

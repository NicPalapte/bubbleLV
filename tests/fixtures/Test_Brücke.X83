   <BoQBody>
    <Remark ID="AAAAAAABIEAHFEGI">
     <Description ID="R20231201134801955000002">
      <CompleteText>
       <DetailTxt>
        <Text>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Hinweise:</span>
         </p>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Der Abschnitt 1 enthält die allgemeinen Leistungen für die Abschnitte 2 bis 4. Die allgemeinen Leistungen des Abschnitts 5 &#x22;Straßenbau&#x22; sind im Abschnitt 5 gesondert beschrieben.</span>
         </p>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Erdbaumaßnahmen in den Abschnitten 2 bis 4 beinhalten alle notwendigen Arbeiten unterhalb des Straßenplanums und im Bereich der Böschungen unterhalb der Brücke. Die restlichen Erdarbeiten außerhalb des Brückenbereichs (begrenzt durch die Übergangskonstruktionen) und oberhalb des Planums sind in Abschnitt 5 enthalten.</span>
         </p>
        </Text>
       </DetailTxt>
       <OutlineText>
        <OutlTxt>
         <TextOutlTxt>
          <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
           <span>Hinweis:</span>
          </p>
         </TextOutlTxt>
        </OutlTxt>
       </OutlineText>
       <!-- GAEB version used: 330 -->
       <!-- GAEB version used: 330 -->
      </CompleteText>
     </Description>
    </Remark>
    <BoQCtgy ID="AAAAAAABIEAIAAAA" RNoPart="1">
     <LblTx>
      <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
       <span>Allgemein</span>

             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Heizung Einhausung betreiben auf Anweisung des AG</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>

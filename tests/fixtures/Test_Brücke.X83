          <Description ID="R20240103193121714000437">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ausbaumaterialien laden und entsorgen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Rohrgeländer, Bügel, Poller, Pfosten, Verkehrszeichen, Wegweisungstafel</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">einschl. Betonfundament im Baustellenbereich lagernd, laden, transportieren und einer fachgerechten Verwertung zuführen.</span>
              </p>

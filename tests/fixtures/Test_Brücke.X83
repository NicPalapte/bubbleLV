         </Item>
         <Item ID="AAAAAAABIEDJGMHI" RNoPart="100">
          <Qty>46.000</Qty>
          <QU>St</QU>
          <Description ID="R20220514171423061000012">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Verankerung für Geländer nach Unterlagen des AG einbau-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">en.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einbau auf Brücke.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Verankerung durch verschweißen</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Stahlfläche nach Unterlagen des AG mit Korrosionsschutz</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">versehen. Lt. Tabelle &#x22;Korrosionsschutzsysteme&#x22; der</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">ZTV-ING Teil 4, Abschnitt 3, Anhang A. Oberflächenvor-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">bereitung wird gesondert vergütet.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Zu beschichtendes Bauteil Geländerverankerungen</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Zugrundegelegte Korrosionsbelastung C5-I und C5-M</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Korrosionsschutzsystem Nr. 1.3.1 b) Nr. 1</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Deckbeschichtung auf der Baustelle aufbringen, übrige</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Beschichtungen im Werk aufbringen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Erforderliche Zwischenreinigungen ausführen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Geländerverankerung einbauen</span>
                <br/>
                <span>Brücke, Verankerung durch verschweißen</span>
                <br/>
                <span>Verz./EP/PUR</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEDJHENA" RNoPart="110">
          <Qty>5.000</Qty>
          <QU>m</QU>
          <Description ID="R20230818125417412000013">
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Geschweißtes Stahlgeländer nach Unterlagen des AG ein-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">bauen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Abgerechnet wird nach Länge des Handlaufs zwischen den</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Achsen der Endpfosten bzw. Endstäbe.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Geländer auf Winkelstützmauer</span>
               <br/>
               <TextComplement MarkLbl="21" Kind="Owner">
                <ComplCaption>
                 <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Material </span>
                </ComplCaption>
                <ComplBody>
                 <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">&#x27;Geländer = Baustahl&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <br/>
               <TextComplement MarkLbl="31" Kind="Owner">
                <ComplCaption>
                 <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Höhe des Geländers </span>
                </ComplCaption>
                <ComplBody>
                 <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">&#x27;= 1300 mm &#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <br/>
               <TextComplement MarkLbl="32" Kind="Owner">
                <ComplCaption>
                 <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ausbildung </span>
                </ComplCaption>
                <ComplBody>
                 <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">&#x27; als Sondergeländer in Anlehnung an RiZ Gel 6&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <br/>
               <TextComplement MarkLbl="51" Kind="Owner">
                <ComplCaption>
                 <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Inklusive Verankerung </span>
                </ComplCaption>
                <ComplBody>
                 <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">&#x27;verdübelt und geschraubt &#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Korrosionsschutz Baustahl: Geländer feuerverzinken, zu be-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">schichtende Flächen sweep-strahlen. Zwischenbeschich-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">tung auf Epoxidharz-Grundlage nach Blatt 87, Soll-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">schichtdicke 80 mym. Deckbeschichtung auf Polyurethan-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Grundlage nach Blatt 87, Sollschichtdicke 80 mym</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Handlauf Edelstahl, mit Konsolen an den Geländerpfosten befestigt.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Obere Geländerholm aus Edelstahl</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Material Geländerfüllung Edelstahl</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Füllung aus Edelstahlrohrrahmen mit Edelstahl-Seilnetzfüllung.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Seilnetz mit d=1,50mm und Maschenweite 60mm</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">

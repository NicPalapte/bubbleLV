    <BoQCtgy ID="AAAAAAABIECNAAAA" RNoPart="4">
     <LblTx>
      <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
       <span>Beleuchtung Brücke</span>
      </p>
     </LblTx>
     <BoQBody>
      <Remark ID="AAAAAAABIECNAJDI">
       <Description ID="R20240712141217828000006">
        <CompleteText>
         <DetailTxt>
          <Text>
           <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
            <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">1.1 Allgemeine Infos:</span>
            <br/>
            <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anzubieten sind Schaltschränke und die Brückenbeleuchtung für:</span>
            <br/>
            <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> Straßenbeleuchtung/Brückenbeleuchtung</span>
            <br/>
            <br/>
            <br/>
            <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">1.2 Preisangabe</span>
            <br/>
            <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anzugeben sind die Lieferpreise einschließlich Transport und Montage.</span>
            <br/>
           </p>
          </Text>
         </DetailTxt>
         <OutlineText>
          <OutlTxt>
           <TextOutlTxt/>
          </OutlTxt>
         </OutlineText>
         <!-- GAEB version used: 330 -->
         <!-- GAEB version used: 330 -->
        </CompleteText>
       </Description>
      </Remark>
      <BoQCtgy ID="AAAAAAABIECNBIAI" RNoPart="1">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>440 Kabel und Leitungen</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Remark ID="AAAAAAABIECNCBEA">
          <Description ID="R20240712141217794000002">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die Leitungen</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Für das Energienetz ist ein durchgängiges TN-S-Netz</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">aufzubauen.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bei der Verlegung sind alle einschlägigen VDE- und</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Herstellervorschriften, insbesondere betreffend</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Strombelastbarkeit, Umgebungsbedingung, Biegeradien</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">usw. zu beachten.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Auf die Koordinationspflicht zu anderen Gewerken wird</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">hier nochmals ausdrücklich hingewiesen.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Das Beschriften am Anfang und Ende der Leitung mit der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Stromkreisnummer gehört mit zum Leistungsumfang.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Alle Leitungen sind in ein bauseitiges Leerrohr einzuziehen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Dies gilt für alle nachstehend ausgeschriebenen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Positionen</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabelverlegung:</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabel und Leitungen sind sach- und fachgerecht zu verlegen.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Alle Leitungen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Remark>
         <Item ID="AAAAAAABIECNDBJI" RNoPart="10">
          <Qty>120.000</Qty>
          <QU>m</QU>
          <Description ID="R20240712141217813000003">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">NYY  5 x 2,5  mm² in Leerrohr eingezogen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">PVC-Starkstromkabel nach HD603 / VDE 0276-603. Erdkabel</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">zur Gebäudeinstallation und Festverlegung mit</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">verschiedenen Einsatzbereichen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Aufbau:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Leiter aus blanken Kupferdrähten, Aderisolation auf</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">PVC-Basis, Füllmischung über dem Aderverband, Außenmantel auf</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">PVC-Basis</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Technische Daten</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Nennspannung:    U0/U: 0,6/1,0 kV</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Prüfspannung:    4000 V</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Temperaturbereich:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bei Verlegung:    -5°C bis +50°C</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Fest verlegt:    -40°C bis +70°C</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">fertig verlegt auf Kabelrinnen, Steigetrassen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabelzugrohr oder in Erdreich</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;tab-stops:19.90mm 35.00mm 55.10mm 75.20mm 94.90mm 114.90mm 134.90mm 154.90mm;">
               <span style="font-family:Arial;font-size:10;mso-tab-count:1;">                   </span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"/>
               <span style="font-family:Calibri;font-size:10pt;Color:rgb(0,0,0);">   </span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>NYY 5  x 2,5  mm²</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIECNENPA" RNoPart="20">
          <Qty>120.000</Qty>
          <QU>m</QU>
          <Description ID="R20240712141217818000004">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">wie vor, NYY 2 x 2,5 mm²</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;tab-stops:19.90mm 35.00mm 55.10mm 75.20mm 94.90mm 114.90mm 134.90mm 154.90mm;">
               <span style="font-family:Arial;font-size:10;mso-tab-count:1;">                   </span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"/>
               <span style="font-family:Calibri;font-size:10pt;Color:rgb(0,0,0);">   </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>NYY 2 x 2,5 mm²</span>
               </p>
              </TextOutlTxt>

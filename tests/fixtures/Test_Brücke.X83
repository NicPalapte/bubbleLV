         <Item ID="AAAAAAABIEDIAIFI" RNoPart="160">
          <Qty>19.000</Qty>
          <QU>m3</QU>
          <Description ID="R20220530130752565000009">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bewehrte Betonfertigteile entsprechend statischen und</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">konstruktiven Erfordernissen nach Unterlagen des AG</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">herstellen und einbauen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bauteil = Stützwand.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Fertigteile aus Stahlbeton. Bewehrung wird gesondert</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">vergütet.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Druckfestigkeitsklasse C30/37.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Expositionsklasse XC4, XD1, XF2, XA1, WA </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Verschibesicherung nach Vorgaben des Herstellers einbauen</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Zusätzliche Anforderungen  = Verwendung von CO2-reduzierten Betonen, mindestens Level 2 gemäß CO2-Modul des CSC, Transportbetonwerk mindestens mit dem CSC CO2-Modul in Gold zertifiziert</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Betonfertigteile herstellen, liefern und einbauen</span>
                <br/>
                <span>Stützwand*FT:StBn, Bew.ges.</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEDIBALA" RNoPart="170">
          <Qty>3.500</Qty>
          <QU>m3</QU>
          <Description ID="R20240105200523869000002">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Unbewehrten Beton nach Unterlagen des AG herstellen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Beton als Unterbau für die Winkelstützwände erfeucht einbauen und die Winkelstützwände höhen und lagerichtig darauf versetzen </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Druckfestigkeitsklasse C12/15.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Expositionsklasse X0.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Zusätzliche Anforderungen Dicke mind 10 cm </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Beton einschließlich Schalung herstellen. Schalung vor-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">halten und beseitigen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Unbewehrten Beton herstellen</span>
                <br/>
                <span>C12/15, X0*.</span>
                <br/>
                <span>Mit Schalung</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEDIBJAI" RNoPart="180">
          <Qty>2.000</Qty>
          <QU>t</QU>
          <Description ID="R20220530130823779000010">
           <StLNo Type="StLK">1611821379</StLNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Betonstahl entsprechend statischen und konstruktiven</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Erfordernissen einbauen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bauteil = Stützwand.</span>
               <br/>
               <TextComplement MarkLbl="21" Kind="Owner">
                <ComplCaption>
                 <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Stahlsorte </span>
                </ComplCaption>
                <ComplBody>
                 <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">&#x27;B500B</span>
                 <br/>
                 <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Verwendung von CO2-reduziertem Betonstahl, GWP für die Phasen A1 bis A3 &#x3c;= 480 kgCO2-Äquivalent/t, Nachweis über Produktionszertifikate&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Betonstahl einbauen</span>
                <br/>
                <span>Stützwand*</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEDICBGA" RNoPart="190">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <Description ID="R20240413101031608000002">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anschluss der Winkelstützwände an Bestand.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bestehende bauliche Anlagen bestehend aus Natursteinmauern, Geländern, Zäunen, Bordsteinen usw. im Baugrubenbereich der Winkelstützwände zurückbauen, Baustoffe lagern und nach der Errichtung der Winkelstützwände wieder einbauen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bauteil = Winkelstützwände Nordwest (Achse 20 / Anliegerstraße)</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Der Rück- und Neubau der Oberflächenbefestigung wird gesondert vergütet.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Anschluss Winkelstützwände an Bestand Nordwest</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEDICJLI" RNoPart="200">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <Description ID="R20240413105343652000007">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anschluss der Winkelstützwände an Bestand.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bestehende bauliche Anlagen bestehend aus Natursteinmauern, Geländern, Zäunen, Bordsteinen usw. im Baugrubenbereich der Winkelstützwände zurückbauen, Baustoffe lagern und nach der Errichtung der Winkelstützwände wieder einbauen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bauteil = Winkelstützwände Nordost (Achse 20 / Gehweg)</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Der Rück- und Neubau der Oberflächenbefestigung wird gesondert vergütet.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Anschluss Winkelstützwände an Bestand Nordost</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEDIDCBA" RNoPart="210">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <Description ID="R20240413105416188000008">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anschluss der Winkelstützwände an Bestand.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bestehende bauliche Anlagen bestehend aus Natursteinmauern, Geländern, Zäunen, Bordsteinen usw. im Baugrubenbereich der Winkelstützwände zurückbauen, Baustoffe lagern und nach der Errichtung der Winkelstützwände wieder einbauen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bauteil = Winkelstützwände Südost (Achse 10 / Gehweg)</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Der Rück- und Neubau der Oberflächenbefestigung wird gesondert vergütet.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Anschluss Winkelstützwände an Bestand Südost</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEDIDKGI" RNoPart="220">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <Description ID="R20240413105735679000009">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bestehende Treppe bestehend aus Natursteinmauer, Stahlbetontreppe, Betonsteinpflaster, Kantensteinen im Baugrubenbereich der Winkelstützwände zurückbauen, Baustoffe lagern und nach der Errichtung der Winkelstützwände wieder einbauen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bauteil = Gartentreppe Haus Bettrather Str. 12 (Achse 10 / Gehweg)</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Der Rück- und Neubau der Oberflächenbefestigung wird gesondert vergütet.</span>
              </p>

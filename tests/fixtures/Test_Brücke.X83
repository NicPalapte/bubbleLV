         <Item ID="AAAAAAABIECIGMHI" RNoPart="30">
          <Qty>6.000</Qty>
          <QU>m</QU>
          <Description ID="R20240105184745082000001">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">KG-Anschlussleitung DN 160 liefern und verlegen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Vollwandrohrsystem KG-2000 nach DIN EN 14758-1 aus Polypropylen (PP) in DN 160 (OD), mineralverstärkt, einschließlich der erforderlichen Dichtungen, aller Form- und Passstücke soweit diese nicht in eigenen Positionen enthalten sind.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Farbe: Maigrün RAL 6017</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Anschluss einseitig an die elastischen Rohrverbinder</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">durch die  Dichtelemente in den Widerlager führen,</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Kurzstücke bis ca. 1 m Länge</span>

              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Den vorgegebenen Anforderungen entspricht z.B.:</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Fabrikat:</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Arboflex Stammschutzfarbe mit Voranstrich (Flügel GmbH)</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;text-decoration:underline;font-size:10pt;Color:rgb(0,0,0);">angebotenes Fabrikat/Typ des Bieters:</span>
              </p>
              <p style="margin-left:1pt;text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="margin-left:1pt;text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="margin-left:1pt;text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;tab-stops:19.90mm 35.00mm 55.10mm 75.20mm 94.90mm 114.90mm 134.90mm 154.90mm;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Name:</span>
               <span style="font-family:Arial;font-size:10;mso-tab-count:1;">         </span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;</span>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Arboflex&#x27;</span>
              </p>
              <p style="margin-left:1pt;text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="margin-left:1pt;text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="margin-left:1pt;text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bei Nichtausfüllung des angebotenen Fabrikates gilt die Angabe des</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Leitproduktes als vertraglicher Bestandteil.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Verdunstungs-/Stammschutz aufbringen</span>
               </p>

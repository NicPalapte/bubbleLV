              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schottertragschicht (RCL I) 0/45, 150 MPa, d=15 cm herstellen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>

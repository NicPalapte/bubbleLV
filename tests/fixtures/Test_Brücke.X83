         <Item ID="AAAAAAABIEDIHNCI" RNoPart="50">
          <Qty>150.000</Qty>
          <QU>m2</QU>
          <Description ID="R20231115174959400000008">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Erstellen und Abbau Arbeitsgerüst 4Wo Standgerüst längenorientiert Rahmen 2kN/m2 SW06 H1</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Gerüstarbeiten: erstellen, abbauen</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Verwendung Gerüst: Arbeitsgerüst</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bauart Gerüst: Standgerüst</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ausbildung Gerüst: längenorientiert</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ausführung Gerüst: Fassadengerüst DIN EN 12810-1 als Rahmengerüst</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bauteil, Einrüstung: Gebäude Bettrahter Straße 7, Verbindungsweg Viersener Straße</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Lastklasse Gerüst: 3 (2 kN/m2)</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Breitenklasse Gerüst: SW06</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Höhenklasse Gerüst: H 1</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Nutzungsumfang Gerüstlagen: alle Gerüstlagen</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Zusätzlicher Seitenschutz Gerüst: genutzte Gerüstlagen mit zusätzl. wandseitigem Seitenschutz</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Vergütung zusätzlicher Seitenschutz Gerüst: zusätzlicher wandseitiger Seitenschutz wird nicht gesondert vergütet</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Verankerung Gerüst: verankern</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Untergrund Befestigung: Tragkonstruktion - Fassade aus Mauerwerk</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Anwendung Einrüstung: zur Evakuierung der Balkone. </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ausbildung Einrüstfläche: senkrecht</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Spezielle Ausbildung Einrüstfläche: ohne Angabe</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Lage Bearbeitungsfläche: Bauwerk, außen</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Aufstellort Gerüst: Gelände</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Höhe [m] oberste Gerüstlage: 14</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ausbildung Stand-/Aufhängefläche: Standfläche waagerecht</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Belastbarkeit Stand-/Aufhängefläche: über Lastverteiler belastbar</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Abrechnungseinheit: m2</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Gebrauchsüberlassung Dauer: 4 Wochen (Grundeinsatzzeit)</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Vergütung Vorhalten/Gebrauchsüberlassung: wird für die Grundeinsatzzeit nicht gesondert vergütet</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Angaben zur Gerüstlänge: zwischen den Balkonen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Angaben zur Gerüsthöhe: letzte Gerüstlage im Bereich des obersten Balkones</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Erstellen, Abbau Arbeitsgerüst 4Wo Standgerüst längenorientiert Rahmen 2kN/m2 SW06 H1</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEDIIFIA" RNoPart="60">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <Description ID="R20231115174959409000009">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Aufbau Abbau Treppenaufgang 2-läufig 4Wo H 13-14m Lauf-B 0,75-1m</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Leistungsumfang Gerüstarbeiten: aufbauen, abbauen</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bauteil, Gerüst: Treppenaufgang für Gerüst</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einbaulage/Befestigungsbauteil: Gerüst</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Anzahl Treppenläufe: 2-läufig</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Verlauf Aufgang/Leitergang: Treppenaufgang von Standfläche bis oberste Gerüstlage</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Höhenbereich [m] Treppenaufgang/Leitergang: über 13 bis 14</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Breitenbereich [m] Treppenlauf: über 0,75 bis 1</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Höhenabstand [m] Podeste: ohne Angabe</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ausführungsunterlagen: ohne Angabe</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Abrechnungseinheit: St</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Gebrauchsüberlassung Dauer: 4 Wochen (Grundeinsatzzeit)</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Vergütung Vorhalten/Gebrauchsüberlassung: wird für die Grundeinsatzzeit nicht gesondert vergütet</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Der Treppenturm ist in der untersten Ebene gegen unbefugten Zutritt zu sichen (Zaunelemten mit Tür).</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Diese Tür ist mittels einer Kette und Vorhängeschloss zu sichern. Der Schlüssel ist der Feuerwehr zu übergeben.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Aufbau Abbau Treppenaufgang 2-läufig 4Wo H 13-14m Lauf-B 0,75-1m</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>

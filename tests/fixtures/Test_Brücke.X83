         <Item ID="AAAAAAABIECNGIGI" RNoPart="30">
          <Qty>130.000</Qty>
          <QU>m</QU>
          <Description ID="R20240712141217823000005">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;tab-stops:20.10mm 35.00mm 55.10mm 75.20mm 94.90mm 114.90mm 134.90mm 154.90mm;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">wie vor, NYY 5 x 10 mm²</span>
               <span style="font-family:Arial;font-size:10;mso-tab-count:1;"/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"/>
               <span style="font-family:Calibri;font-size:10pt;Color:rgb(0,0,0);">   </span>

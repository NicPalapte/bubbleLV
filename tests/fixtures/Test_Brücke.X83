          <Qty>4.000</Qty>
          <QU>St</QU>
          <Description ID="R20240301130425124000106">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schmutzfänger schwere Ausführung aus verzinktem</span>
               <br/>

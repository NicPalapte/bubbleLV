         <Item ID="AAAAAAABIEHHDEBI" RNoPart="70">
          <Qty>210.000</Qty>
          <QU>m2</QU>
          <Description ID="R20240103193122790000631">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Feinplanum für Staudenflächen herstellen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Gilt für Homogenitätsbereich &#x22;A&#x22; und gelieferten</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Oberboden.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Abweichungen von der Sollhöhe: +/- 3 cm unter 4 m Latte</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Böschungen / Hangneigung: bis 1:2</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ausführung: Anschlüsse an Wege, Plätze und sonstige</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Beläge 2 cm tiefer ausführen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Unrat und Steine mit einem Durchmesser &#x3e; 5 cm und</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">schwer verrottbare Pflanzenteile sind abzulesen und</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">gemäß Kreislaufwirtschaftsgesetz zu entsorgen, die</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Kosten sind einzukalkulieren.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Feinplanum für Staudenflächen herstellen.</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEHHEPPI" RNoPart="80">
          <Qty>2.000</Qty>
          <QU>m3</QU>
          <Description ID="R20240103193122794000632">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Mineralischen Mulch aufbringen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Mineralischen Mulch 8/16 aufbringen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Lava 8/16 liefern und aufbringen nach Pflanzung.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Dicke: 6 cm</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Stauden dürfen nicht überschüttet werden- dies ist bei der Pfflanzung zu berücksichtigen</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Mineralischen Mulch aufbringen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
      <BoQCtgy ID="AAAAAAABIEHHHDLI" RNoPart="57">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Pflanzenlieferung / Bäume</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Remark ID="AAAAAAABIEHHHMPA">
          <Description ID="R20240103193122801000634">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">ZTV Pflanzung und Pflanzenlieferung</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Lieferung hat gemäß  FLL-Gütebestimmungen für</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Baumschulen und FLL-Gütebestimmungen für Stauden</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">und den BDB-Gütebestimmungen zu liefern zu erfolgen.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Transporte, Verpackungen sowie das Abladen,</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Zwischenlagern, Verteilen bzw. ggfs. erforderliches</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einschlagen sind Nebenleistungen und werden nicht</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">gesondert vergütet.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Lieferbaumschule ist namentlich zu benennen.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Lieferbaumschule:</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">&#x27;Wegmann Baumschule &#x26; Handel&#x27;</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">vom Bieter auszufüllen.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Pflanzung</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Sämtliche Pflanzarbeiten dürfen nur bei frostfreier</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Witterung vorgenommen werden. Pflanzabstand der</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">einzelnen Pflanzen zueinander sowie Entfernungen zu</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Wege/Straßen, Nachbargrundstücken sind nach Pflanzplan</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">bzw. den örtlichen Angaben des AG und den behördlichen</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bestimmungen vorzunehmen.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Pflanztermine sind abhängig von der Pflanzenart,</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">dem Baufortschritt, der Witterung und der Jahreszeit.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Aus dem im Bauablauf ggfs. nachträglichen Pflanzen des</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Pflanzenmaterials resultierende Mehraufwendungen (u.a.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">für Verkehrssicherung, BE, etc.) sind in die</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einheitspreise einzukalkulieren und werden nicht</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">gesondert vergütet.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Das Lockern der Pflanzflächen nach den Pflanzarbeiten</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">und herstellen der Gießränder sind Nebenleistungen und</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">werden nicht gesondert vergütet.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Pflanzenlieferung</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Pflanzen werden vor der Lieferung durch den AG in</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">der durch den AN ausgewählten Baumschule/Pflanzenlieferant ausgewählt und</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">ausgebunden (Bäume und Gehölze).</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Pflanzenlieferung und Beginn der Pflanzarbeiten sind</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">dem AG durch den AN frühzeitig, mind. jedoch zwei</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Kalenderwochen vorher anzuzeigen. Ersatzlieferungen für</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">die ausgeschriebenen Pflanzen bedürfen ausdrücklichen und schriftlichen Zustimmung durch den Fachbereich 66.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Abnahme der Pflanzung erfolgt nach Beendigung der</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Fertigstellungspflege. Die Abnahme ist vom AN</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">schriftlich zu beantragen. Die Abnahme der</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">nachgepflanzten Pflanzen erfolgt erst nach Ende einer</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">weiteren abgeschlossenen Vegetationsperiode.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Pflanzen sind nach erfolgter Pflanzung ausreichend</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">zu wässernïAA¿. Die Kosten fÃ¼r die Bereitstellung des</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Wassers sind mit einzurechnen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>ZTV Pflanzung und Pflanzenlieferung</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Remark>
         <Item ID="AAAAAAABIEHHJAPI" RNoPart="10">
          <Qty>3.000</Qty>
          <QU>St</QU>
          <Description ID="R20240103193122805000635">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Acer campestre &#x27;Huibers Elegant&#x27;</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Hochstamm liefern</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">3xv. m.Db. 18-20cm Hochstamm Kronenansatz 2,20-2,50m</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Acer campestre &#x27;Huibers Elegant&#x27;</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEHHKLJA" RNoPart="20">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <Description ID="R20240103193122809000636">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Tilia tomentosa Brabant </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Hochstamm liefern</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">3xv. m.Db. 18-20 cm Hochstamm Kronenansatz 2,20-2,50m</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Tilia tomentosa Brabant </span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEHHMGCA" RNoPart="30">
          <Qty>4.000</Qty>
          <QU>St</QU>
          <Description ID="R20240103193122814000637">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Hochstämmige Bäume pflanzen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bäume entsprechend DIN 18916 in vorzubereitendes Pflanzloch</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">in Substrat pflanzen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die Bäume sind abzuladen und zu der jeweiligen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Verwendungsstelle zu transportieren.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Für die Lade- und Pflanzarbeiten ist ein Ballenhaken</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">zu verwenden.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Das Pflanzloch ist mit dem vorgesehenen Substrat per</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Handarbeit zu verfüllen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Mögliche Setzungen sind zu Berücksichtigen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Nach der Pflanzung (am gleichen Tag) ist um den</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ballen der Gießring (innerhalb des 3-Bocks) zu</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">errichten</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">und mit 75-100 l/Baum  einzuschlämmen, für Bodenschluss.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Das Knoten des Ballentuches und der Spanndraht sind zu</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">öffnen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Baumqualität: 18-20 </span>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(253,2,0);"> </span>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">m.Db.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Kronenansatz : 2,2m-2,5m</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Hochstämmige Bäume pflanzen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>

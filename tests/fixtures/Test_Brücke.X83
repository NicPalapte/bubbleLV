         <Item ID="AAAAAAABIECPLAGI" RNoPart="60">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <Description ID="R20240712141217897000019">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Messung der Isolationswiderstände und Kurzschlussströme eines Beleuchtungskreises,   einschließlich </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Erstellung und Übergabe eines Messprotokoll </span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Messung der Isolationswiderstände und Kurzschlussströme</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIECPMKNA" RNoPart="70">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <Description ID="R20240712141217901000020">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Dokumentation Beleuchtung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vollständige Dokumentation aller Beleuchtungskreise liefern. </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- Ausbaudaten Altmasten (Ausbaudatum, Typ)</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- Ausbaudaten demontierter Leuchten (Ausbaudatum, Ausbauwattage, Typ)</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">-  Lagepläne</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- Trassenpläne</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">-  Materiallisten</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- VDE Messungen / Protokolle</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">-  Schleifenwiderstandsmessung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">-  Erdmessung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- Kabeldaten (Herstellungsjahr, Typ)</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">-  Beleuchtungsstandorte und Leitungslagen der Beleuchtungskabel und</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> der Leerverrohrung sind mit einer Genauigkeit </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x3c; 10 cm einzumessen und</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">getrennt nach Beleuchtungsstandort und Leitungslagen in einer Datei im MapInfo-Format oder ArcGIS-Format einzureichen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die Dokumentation ist in digitaler Form an den AG zu übergeben.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Dokumentation und Revisionsaunterlagen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
      <BoQCtgy ID="AAAAAAABIECPOPNI" RNoPart="4">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>440 Erdungs und Potentialausgleich</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Remark ID="AAAAAAABIECPPJBA">
          <Description ID="R20240712141217908000022">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vorbemerkung</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Der Fundamenterder ist in</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Betonstützen oder in Stahlstützen im Bauwerk nach oben zu führen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">An den Stellen, an denen der Fundamenterder die</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Stützen verlässt, ist er in V4A auszuführen.</span>
               <br/>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vorbemerkung Potentialausgleichsleiter</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Potentialausgleichsleiter müssen in den Farben</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">grün/gelb verlegt werden oder an beiden Enden als solcher gekennzeichnet sein.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Alle Metallteile der elektrischen Betriebsstätten sind in den Potentialausgleich einzubeziehen.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Der gesamte Potentialausgleich muss entsprechend den derzeit gültigen VDEW/VDE und VdS-Richtlinien durchgeführt werden.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Für die nachfolgenden Leitungen ist eine Mischverlegung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kunststoffaderleitungen und halogenfreie Mantelleitungen nach DIN VDE 0250 sind sach- und fachgerecht zu verlegen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">In den Positionspreisen ist das erforderliche Klein- und Befestigungsmaterieal enthalten.</span>
               <br/>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Vorbemerkung</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Remark>
         <Item ID="AAAAAAABIEFLAJKI" RNoPart="10">
          <Qty>20.000</Qty>
          <QU>m</QU>
          <Description ID="R20240712141217916000023">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ringerder Rd 10, NIRO V4A</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ringleiter nach DIN EN 50164-2 (VDE 0185 Teil 202), für</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">den Einsatz bei Erdungsanlagen, Blitzschutzanlagen und</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">beim Ringpotentialausgleich, Rd 10, Material NIRO V4A,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">in der Schalung, an der Bewehrung, abschnittsweise im</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zuge des Baufortschritts horizontal verlegen und pro</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">lfd. Meter mit der Bewehrung verklemmen. </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Eventuell in der vertikalen Lage als Anschlussfahne für Potentialausgleich und Blitzschutz mit der Ableitung verklemmen und nach oben führen, Anschlusslänge außen &#x3e; 1,50 m. mit Schutzkappen</span>
               <br/>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">inkl. Abstandshalter im Erdreich</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Liefern und montieren.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Ringerder Rd 10, NIRO V4A</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEFLCFIA" RNoPart="20">
          <Qty>15.000</Qty>
          <QU>m</QU>
          <Description ID="R20240712141217923000024">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Stahlband 30 mm Breite / 105mm² St/tZn</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bänder nach DIN EN 62561-2 (VDE 0185 Teil 202), für den Einsatz bei Erdungsanlagen, Blitzschutzanlagen und beim Ringpotentialausgleich.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Breite: 30 mm</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Dicke: 3,5 mm</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Werkstoff: St/tZn</span>
               <br/>
               <br/>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>

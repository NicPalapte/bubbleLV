          <Qty>230.500</Qty>
          <QU>m</QU>
          <Description ID="R20240103193121613000417">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Rinnen- oder Abschlussbahn lösen, laden und entsorgen, bis 16 cm</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einreihige Rinnen- oder Abschlussbahn aus Beton- oder Naturstein, in Beton versetzt, einschließlich Fundament lösen, laden, transportieren und einer </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">fachgerechten Verwertung zuführen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">

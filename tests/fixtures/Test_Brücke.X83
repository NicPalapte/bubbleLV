         <Item ID="AAAAAAABIEDJBALA" RNoPart="101">
          <Qty>12.000</Qty>
          <QU>m</QU>
          <Description ID="R20240413131918550000015">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Kabelschutzrohr Edelstahl,  DN 25, Werkstoff Nr:1.4404 einschließlich erforderlicher Muffen, Kupplungen, Schellen liefern und an der Stahlkonstruktion des Überbaues und dem Widerlager einbauen .</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">einschließlich Formstücke, einschließlich der erforderlichen Bohrungen / Fräsungen in den Profilen, einschließlich flexiblen Verbindung aus Riffelrohr, einschließlich Befestigungspunkte an Überbau und Widerlager, dem wasserdichten Verbinden der Rohre untereinander, sowie das Einführen eines Zugdrahtes.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <br/>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Kabelschutzrohr Edelstahl DN 25 liefern, Am Überbau und Widerlager</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEDJBJAI" RNoPart="110">
          <Qty>6.000</Qty>
          <QU>St</QU>
          <Description ID="R20231115175723681000013">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Messbolzen einbauen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einbauort = Überbau.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Material = nichtrostender Stahl </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Schaftdurchmesser 10 bis 20 mm.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Schaftlänge 18 mm </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einbau vertikal.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bolzen auf orthotroper Fahrbahnplatte mit Kehlnaht 3,5 mm anschweißen, Schaftlänge entspricht Dicke des Belags von 6 mm </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Messbolzen für Lage- und Höhenmessung.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Messbolzen einbauen</span>
                <br/>
                <span>Überbau, nichtrostender Stahl</span>
                <br/>
                <span>DU 10 - 20 mm, Schaftlänge bis 18 mm</span>
                <br/>
                <span>Vertikal. Bolzen mit Kehlnaht 3,5 mm anschweißen</span>
                <br/>
                <span>Lage-/Höhenmessg</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
      <BoQCtgy ID="AAAAAAABIECGBHJI" RNoPart="8">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Lager, ÜKO, Schwingungstilger, Geländer, Sitzbank, Stahlbau</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Remark ID="AAAAAAABIECGCANA">
          <Description ID="R20220514164818594000002">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">LAGER</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>LAGER</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Remark>
         <Remark ID="AAAAAAABIECGCOKI">
          <Description ID="R20240206190525828000001">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die Lager für die Brücke wurden vom Tragwerksplaner bemessen.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Falls der AN ggf. andere Lager oder andere Lagerabmessungen in seiner Werksplanung vorsieht bzw. verwendet,</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">sind Kosten für die Umbemessung und Umplanung für alle davon betroffenene Bauteile (Lager, Überbau, Lagersockel, Widerlager usw.) vom AN zu tragen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Umbemessung Lager</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Remark>
         <Item ID="AAAAAAABIEDJCBGA" RNoPart="10">
          <Qty>2.000</Qty>
          <QU>St</QU>
          <Description ID="R20220514165533938000006">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Elastomerlager einschließlich oberer und unterer Anker-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">platte nach Unterlagen des AG einbauen.Für den Korrosi-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">onsschutz zu beachten:</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bei betonberührten Flächen Randstreifen von 5 cm mitbe-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">schichten. Bei Berührungsflächen Stahl/Elastomer nur</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Randstreifen von 2cm beschichten. Ggf. vorhandene Kon-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">taktfläche zwischen Lager- und Ankerplatte vorbereiten,</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Vorbereitungsgrad Sa 2 1/2, und beschichten mit einer</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Grundbeschichtung auf Alkalisilikat-Grundlage mit Zink-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">staub nach Blatt 85, Sollschichtdicke = 40 mym.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einbau auf Widerlager.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Elastomerlager allseitig beweglich</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Zulässige Verschiebung +/- 55mm längs, +/- 6 mm quer </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Lager rechteckig, aufnehmbare Normalkraft 2,10MN </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Korrosionsschutz: Stahlflächen vorbereiten, Vorberei-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">tungsgrad Sa 2 1/2. Grundbeschichtung auf Epoxidharz-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Zinkstaub-Grundlage nach Blatt 87, Sollschichtdicke 70</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">mym. 1. und 2. Zwischenbeschichtung sowie Deckbeschich-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">tung mit Eisenglimmer auf Epoxidharz-Grundlage nach</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Blatt 87, Sollschichtdicke je 80 mym.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Elastomerlager einbauen</span>
                <br/>
                <span>Widerlager, allseitig beweglich</span>
                <br/>
                <span>zulässige Verschiebung +/- 55 mm längs, +/- 6 mm quer, aufnehmbare Normalkraft 2,10 MN.</span>
                <br/>
                <span>EP-Zinkst/EP</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEDJCJLI" RNoPart="20">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <Description ID="R20220514165645861000007">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Elastomerlager einschließlich oberer und unterer Anker-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">platte nach Unterlagen des AG einbauen.Für den Korrosi-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">onsschutz zu beachten:</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bei betonberührten Flächen Randstreifen von 5 cm mitbe-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">schichten. Bei Berührungsflächen Stahl/Elastomer nur</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Randstreifen von 2cm beschichten. Ggf. vorhandene Kon-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">taktfläche zwischen Lager- und Ankerplatte vorbereiten,</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Vorbereitungsgrad Sa 2 1/2, und beschichten mit einer</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Grundbeschichtung auf Alkalisilikat-Grundlage mit Zink-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">staub nach Blatt 85, Sollschichtdicke = 40 mym.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einbau auf Widerlager.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Elastomerlager mit Festhaltekonstruktion für eine Ach-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">se.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Zulässige Verschiebung +/- 55mm längs </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Lager rechteckig, aufnehmbare Normalkraft 2,10MN </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Aufnehmbare Kraft in Bauwerksquerrichtung 0,2 MN.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Korrosionsschutz: Stahlflächen vorbereiten, Vorberei-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">tungsgrad Sa 2 1/2. Grundbeschichtung auf Epoxidharz-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Zinkstaub-Grundlage nach Blatt 87, Sollschichtdicke 70</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">mym. 1. und 2. Zwischenbeschichtung sowie Deckbeschich-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">tung mit Eisenglimmer auf Epoxidharz-Grundlage nach</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Blatt 87, Sollschichtdicke je 80 mym.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Elastomerlager einbauen</span>
                <br/>
                <span>Widerlager*1 Achse fest</span>
                <br/>
                <span>zul. Verschiebung +/- 55 mm längs, aufnehmbare Normalkraft 2,10 MN.</span>
                <br/>
                <span>HQ = 0,2 MN*EP-Zinkst/EP</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEDJDCBA" RNoPart="30">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <Description ID="R20220519144034224000002">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Elastomerlager einschließlich oberer und unterer Anker-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">platte nach Unterlagen des AG einbauen.Für den Korrosi-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">onsschutz zu beachten:</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Bei betonberührten Flächen Randstreifen von 5 cm mitbe-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">schichten. Bei Berührungsflächen Stahl/Elastomer nur</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Randstreifen von 2cm beschichten. Ggf. vorhandene Kon-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">taktfläche zwischen Lager- und Ankerplatte vorbereiten,</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Vorbereitungsgrad Sa 2 1/2, und beschichten mit einer</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Grundbeschichtung auf Alkalisilikat-Grundlage mit Zink-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">staub nach Blatt 85, Sollschichtdicke = 40 mym.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einbau auf Widerlager.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Elastomerlager mit Festhaltekonstruktion für zwei Ach-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">sen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Zulässige Verschiebung +/- 0 mm </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Lager rechteckig, aufnehmbare Normalkraft 2,10MN  </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Aufnehmbare Kraft in Bauwerkslängsrichtung 0,6 MN </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Aufnehmbare Kraft in Bauwerksquerrichtung 0,2 MN.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Korrosionsschutz: Stahlflächen vorbereiten, Vorberei-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">tungsgrad Sa 2 1/2. Grundbeschichtung auf Epoxidharz-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Zinkstaub-Grundlage nach Blatt 87, Sollschichtdicke 70</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">mym. 1. und 2. Zwischenbeschichtung sowie Deckbeschich-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">tung mit Eisenglimmer auf Epoxidharz-Grundlage nach</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Blatt 87, Sollschichtdicke je 80 mym.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Elastomerlager einbauen</span>
                <br/>
                <span>Widerlager*2 Achsen fest</span>
                <br/>
                <span>zul. Verschiebung +/- 0,0 mm, aufnehmbare Normalkraft 2,10 MN.*... Freitext ...</span>
                <br/>
                <span>... Freitext ...*HQ = 0,2 MN</span>
                <br/>
                <span>EP-Zinkst/EP</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Remark ID="AAAAAAABIECGDMOI">
          <Description ID="R20220514164911151000004">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">ÜBERGANGSKONSTRUKTION (ÜKO)</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>ÜBERGANGSKONSTRUKTION (ÜKO)</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Remark>
         <Item ID="AAAAAAABIEDJDKGI" RNoPart="40">
          <Qty>12.000</Qty>
          <QU>m</QU>
          <Description ID="R20220514170618636000009">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Wasserundurchlässige Übergangskonstruktion aus Stahl</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">entsprechend statischen und konstruktiven Erfordernis-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">sen einschliesslich Schrammbord- und Gesimsausbildung</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">nach Unterlagen des AG einbauen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Abgerechnet wird nach Länge der Konstruktion in der</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Profilachse, horizontal.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einbau in gesamter Überbaubreite.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Konstruktion mit Dehnungsmatte und Unterkonstruktion</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">analog RiZ Übe 1.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Übergangskonstruktion Achse 10 </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Gesamtdilatation 160mm </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Korrosionsschutz: Stahlflächen vorbereiten. Vorberei-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">tungsgrad Sa 2 1/2. Grundbeschichtung auf Epoxidharz-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Zinkstaub-Grundlage nach Blatt 87, Sollschichtdicke 70</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">mym. 3 Zwischenbeschichtungen und eine Deckbeschichtung</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">auf Epoxidharz-Grundlage nach Blatt 87, Sollschichtdic-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">ke je 80 mym.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Ü-konstr., wasserundurchl., einb.</span>
                <br/>
                <span>Überbaubreite*Dehnungsm.n.RiZ. Achse 10 Gesamtdilatation 160 mm</span>
                <br/>
                <span>EP-Zinkst./EP</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEDJECMA" RNoPart="50">
          <Qty>12.000</Qty>
          <QU>m</QU>
          <Description ID="R20220519151046199000003">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Wasserundurchlässige Übergangskonstruktion aus Stahl</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">entsprechend statischen und konstruktiven Erfordernis-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">sen einschliesslich Schrammbord- und Gesimsausbildung</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">nach Unterlagen des AG einbauen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Abgerechnet wird nach Länge der Konstruktion in der</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Profilachse, horizontal.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Einbau in gesamter Überbaubreite.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Konstruktion mit Dehnungsmatte und Unterkonstruktion</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">analog RiZ Übe 1.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Übergangskonstruktion Achse 20 </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Gesamtdilatation 40mm </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Korrosionsschutz: Stahlflächen vorbereiten. Vorberei-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">tungsgrad Sa 2 1/2. Grundbeschichtung auf Epoxidharz-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Zinkstaub-Grundlage nach Blatt 87, Sollschichtdicke 70</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">mym. 3 Zwischenbeschichtungen und eine Deckbeschichtung</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">auf Epoxidharz-Grundlage nach Blatt 87, Sollschichtdic-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">ke je 80 mym.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Ü-konstr., wasserundurchl., einb.</span>
                <br/>
                <span>Überbaubreite*Dehnungsm.n.RiZ. Achse 20, Gesamtdilatation 40 mm</span>
                <br/>
                <span>EP-Zinkst./EP255</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Remark ID="AAAAAAABIECGELDA">
          <Description ID="R20220525140020195000016">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">SCHWINGUNGSTILGER</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>SCHWINGUNGSTILGER</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Remark>
         <Item ID="AAAAAAABIEDJELBI" RNoPart="60">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <Description ID="R20230908111912093000042">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Schwingungsmessung durch einen unabhängigen </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Sachverständigen mit entsprechender Erfahrung mehr als </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">5 Jahre auf dem Gebiet der Schwingungstechnik von </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Brücken nach Fertigstellung des Überbaus zur </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Feinjustierung der Schwingungsdämpfer durchführen,  </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">auswerten und  2 Schwingungsdämpfer mit diesen </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Messergebnissen bei Bedarf anpassen. </span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schwingungsmessung zur Bemessung der Dämpfer</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEDJFDHA" RNoPart="70">
          <Qty>2.000</Qty>
          <QU>St</QU>
          <Description ID="R20220525140109228000017">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Schwingungsdämpfer entsprechend statischen und </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">konstruktiven Erfordernissen nach Unterlagen des AG einschl.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">aller Verbindungsmittel herstellen und montieren. </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Vorbereiten der Stahloberfläche sowie Aufbringen der </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Beschichtungen sind in die Position einzurechnen und </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">wird nicht gesondert vergütet.  </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Wirkrichtung des Schwingungsdämpfers = vertikal</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Maximale Außenmasse = 1700x900x550 mm</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Die erste Eigenfrequenz und die generalisierte Masse </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">des Überbaus betragen:  f 2 = 1,57 Hz</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Dämpfermasse m 2 je Dämpfer = 3.600 kg</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Der Funktionstest ist von einem unabhängigen, offiziellen </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Sachverständigen (vom AG anerkannt) zu überwachen </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">und die Einhaltung der Tolleranzgrenzen ist von diesem entsprechend zu bestätigen. </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Auf die einwandfreie Funktion der Schwingungsdämpfer </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">ist 10 Jahre Gewährleistung gefordert.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schwingungsdämpfer</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Remark ID="AAAAAAABIECGFJDI">
          <Description ID="R20220514164944854000005">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">GELÄNDER</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>GELÄNDER</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Remark>
         <Item ID="AAAAAAABIEDJFLMI" RNoPart="80">
          <Qty>107.500</Qty>
          <QU>m</QU>
          <Description ID="R20220514171044063000010">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Geschweißtes Stahlgeländer nach Unterlagen des AG ein-</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">bauen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Abgerechnet wird nach Länge des Handlaufs zwischen den</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Achsen der Endpfosten bzw. Endstäbe.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Geländer für Brücke.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Material  Geländer Baustahl  </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Höhe des Geländers = 1300 mm </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Ausbildung als Sondergeländer </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Korrosionsschutz für Baustahl: Geländer feuerverzinken, zu beschichtende Flächen sweep-strahlen. Zwischenbeschichtung auf Epoxidharz-Grundlage nach Blatt 87, Sollschichtdicke 80</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">mym. Deckbeschichtung auf Polyurethan-Grundlage nach</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Blatt 87, Sollschichtdicke 80 mym.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Handlauf Edelstahl, mit Konsolen an den Geländerpfosten befestigt</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Material Geländerfüllung Edelstahl</span>

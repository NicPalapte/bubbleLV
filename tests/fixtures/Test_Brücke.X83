            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Stahlgeländer einbauen</span>
                <br/>
                <span>Brücke, Material Baustahl / Edelstahl, Höhe 1300 mm.</span>
                <br/>
                <span>Sondergeländer, Verankerung verschraubt, Korrosionsschutz Stahl feuerverzinken und beschichten</span>
                <br/>
                <span>.Verz./EP/PUR</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEDJGECA" RNoPart="90">
          <Qty>107.500</Qty>
          <QU>m</QU>
          <Description ID="R20220514171324819000011">
           <CompleteText>
            <ComplTSB>Yes</ComplTSB>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Handlauf einschließlich der Halterungen nach Unterlagen</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">des AG einbauen.</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Handlauf für Absturzsicherung.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Breite = 188 mm</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Höhe = 70 mm</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Handlauf mit Nut für Beleuchtung.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Befestigung am Geländer durch Holzschrauben von unten gemäß Werksplanung des AN. </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Holzhandlauf für die Befestigung vorbohren.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Planmäßige Fuge von 5mm zwischen den Handlaufelementen vorsehen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Inklusive 4 abgerundete gefräste Kopfstücke </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Material Holz Art Pinus Radiata, DIN EN 18556, Holz mit hoher Oberflächenhärte, Oberfläche gehobelt und geschliffen, mit geeignter tranzluzenter, filmbildender Beschichtung geschützt. Ausführung als durchgehend chemisch behandeltes Brettschichtholz mit sehr hoher Witterungsbeständigkeit (Dauerhaftigkeitsklasse 1) mit Spezialverleimung, aus astfreiem Schnittholz gemäß bauaufsichtlicher Zulassung</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Leitprodukt:</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Fabrikat: Kebony Clear Z-9.1-863</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">oder gleichwertig</span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">gewähltes Fabrikat: </span>
               <TextComplement MarkLbl="63" Kind="Bidder" Empty="Yes">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">&#x27;</span>
                 <br/>
                 <br/>
                 <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">....................................................&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <br/>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Typ:  &#x27;Kebony Clear Z-9.1-863&#x27;</span>
               <br/>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">Wird kein anderes Produkt eingetragen, so gilt das Leitprodukt </span>
               <br/>
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);">als angeboten.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:@Arial Unicode MS;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>

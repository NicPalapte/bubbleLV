    <AwardInfo>
      <PrjName>Testprojekt Umbau</PrjName>
      <Client>Muster AG</Client>
      <OpenDate>2026-08-01T00:00:00</OpenDate>
    </AwardInfo>
    <BoQ>
      <BoQInfo>
        <Name>Leistungsverzeichnis</Name>
      </BoQInfo>
      <BoQBody>
        <BoQCtgy RNoPart="01">
          <LblTx>Erdarbeiten</LblTx>
          <BoQBody>
            <Itemlist>
              <Item RNoPart="0010">
                <ShortText>Oberboden abtragen</ShortText>
                <Qty>100.000</Qty>
                <QU>m3</QU>
                <UP>12.50</UP>
                <LongText>Oberboden abtragen und seitlich lagern, Schichtdicke ca. 30 cm.</LongText>
              </Item>
              <Item RNoPart="0020">
                <ShortText>Aushub Baugrube</ShortText>
                <Qty>50.000</Qty>
                <QU>m3</QU>
                <UP>18.00</UP>
                <LongText>Baugrube ausheben bis Unterkante Fundament.</LongText>
              </Item>
            </Itemlist>
          </BoQBody>
        </BoQCtgy>
        <BoQCtgy RNoPart="02">
          <LblTx>Betonarbeiten</LblTx>
          <BoQBody>
            <Itemlist>
              <Item RNoPart="0010">
                <ShortText>Beton C25/30 Fundament</ShortText>
                <Qty>25.000</Qty>
                <QU>m3</QU>
                <UP>145.00</UP>
                <LongText>Ortbeton C25/30 fuer Streifenfundament einbauen.</LongText>
              </Item>
            </Itemlist>
          </BoQBody>
        </BoQCtgy>
      </BoQBody>
    </BoQ>
